@model CopyStart.Entities.ModeloActivo

@{
    ViewData["Title"] = "Detalles";
}





<div class="row justify-content-center">

    <div class="col-md-6 card">
        <div class="card-header">
            <div class="row mb-3">
                <b>Información de modelo de activo</b>
            </div>
            <div class="row">

                <div class="col-md-3 my-2">
                    <a role="button" class="btn btn-block btn-default btn-sm" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
                </div>

                <div class="col-md-3 my-2">
                    <a role="button" class="btn btn-block btn-default btn-sm" asp-action="Index">Volver</a>
                </div>

            </div>
        </div>


        <div class="card-body">

            <dl class="row">
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.MarcaActivo)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.MarcaActivo.Codigo)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Nombre)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Nombre)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Descripcion)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Descripcion)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Codigo)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Codigo)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Estado)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Estado)
                </dd>
            </dl>
        </div>
    </div>

</div>
