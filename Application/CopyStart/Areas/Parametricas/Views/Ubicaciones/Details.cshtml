@model CopyStart.Entities.Ubicacion

@{
    ViewData["Title"] = "Detalles de ubicación";
}


<div class="row justify-content-center">

    <div class="col-md-6 card">
        <div class="card-header">
             <div class="row mb-3"><b>Información de ubicación</b></div>
            <div class="row mb-3">

                <div class="col-md-3 my-2">
                    <a asp-action="Index" role="button" class="btn btn-block btn-default btn-sm">Volver</a>
                </div>
                <div class="col-md-3 my-2">
                    <a asp-action="Edit" asp-route-id="@Model.CodigoMunicipio" role="button" class="btn btn-block btn-default btn-sm">Editar</a>

                </div>
            </div>
        </div>




        <div class="card-body" ">
            <dl class="row">
                <dt class="col-sm-4">
                    Codigo Divipola
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.CodigoMunicipio)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Municipio)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Municipio)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Departamento)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Departamento)
                </dd>
                <dt class="col-sm-4">
                    Ubicacion geografica
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Latitud) , @Html.DisplayFor(model => model.Longitud)
                </dd>
            </dl>

        </div>
    </div>
</div>
