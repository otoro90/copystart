@model IEnumerable<CopyStart.Entities.Persona>

@{
    ViewData["Title"] = "Personas";
}

<div class="row">
    <div class="col-12 form-group">
        <a asp-action="Create" class="btn btn-default bg-primary" role="button">
            Registrar
        </a>
    </div>

    <div class="col-12 form-group">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Listado de personas</h3>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-hover text-center" id="table-personas">
                    <thead>
                        <tr>

                            <th>Nombres completos</th>                          
                            <th>@Html.DisplayNameFor(model => model.NumeroDocumento)</th>
                            <th>@Html.DisplayNameFor(model => model.Estado)</th>
                            <th>Roles</th>   
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var documento = $"{item.TipoDocumento.Codigo} {item.NumeroDocumento}";
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Nombres)  @Html.DisplayFor(modelItem => item.Apellidos)
                                </td>                              
                                <td>
                                    @Html.DisplayFor(modelItem => documento)
                                </td>
                                <td>                               
                                        @Html.DisplayFor(modelItem => item.Estado)                                 
                                </td>
                                <td>
                                    <ul class="list-unstyled">
                                     @foreach (var user in item.Users)
                                    {
                                        @foreach (var role in user.UserRoles)
                                      {
                                        <li> @Html.DisplayFor(modelItem => role.Role.Name)  </li>

                                      } 

                                    }
                                    </ul>
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id" role="button" class="btn btn-default bg-primary"><i class="fas fa-pen"></i></a>
                                    <a asp-action="Details" asp-route-id="@item.Id" role="button" class="btn btn-default bg-secondary"><i class="far fa-file"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" role="button" class="btn btn-default bg-danger"><i class="far fa-trash-alt"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>