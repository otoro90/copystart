@model IEnumerable<CopyStart.Entities.Archivo>

@{
    ViewData["Title"] = "Soportes";
}





<div class="row ">
    <div class="col-12">
        <div class="card">
            <div class="card-body table-responsive">
                <table class="table table-bordered table-hover text-center" id="table-soportes">
                    <thead>
                        <tr>
                            <div class="col-12 mb-4">
                                <h4>Listado de soportes</h4>
                            </div>
                           <div class="col-12 mb-2">
                                <a asp-action="Create" class="btn btn-default bg-primary" role="button">
                                    Registrar
                                </a>
                            </div>
                            <th>
                                @Html.DisplayNameFor(model => model.Nombre)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Tipo)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Peso)
                            </th>

                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Nombre)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Tipo)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Peso) KB
                                </td>
                                <td>
                                      <a asp-action="Download" asp-route-id="@item.Id" role="button" class="btn btn-default bg-primary"><i class="fas fa-download"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" role="button" class="btn btn-default bg-red"><i class="far fa-trash-alt"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>