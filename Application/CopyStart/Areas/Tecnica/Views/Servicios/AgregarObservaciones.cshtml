@model CopyStart.Areas.Tecnica.Models.AggObservaciones

@{
    ViewData["Title"] = "Editar";
}


<div class="row justify-content-center">

    <div class="col-md-12">
        <div class="mt-3">

            <div class="card card-primary">

                <div class="card-body">
                  
                    <dl>
                        <form asp-action="AgregarObservaciones" enctype="multipart/form-data" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                           
                            <div class="form-group">
                                <label> Agrega detalles sobre la realización del servicio (repuestos usados, pendientes a futuro, estado de la maquina al final del servicio), se veran reflejados cuando termine el servicio</label>
                                 @Html.TextAreaFor(modelItem => modelItem.Observaciones, new { style = "width: 100%; height: 70px ", @class = "form-control" })
                                <span asp-validation-for="Observaciones" class="text-danger"></span>
                            </div>
                              <div class="form-group col-12">
                                 <label asp-for="File" class="control-label"></label>
                                 <input asp-for="File" type="file" class="form-control" multiple />
                                <span asp-validation-for="File" class="text-danger"></span>
                            </div>



                            <div class="form-group">
                                <input type="submit" value="Guardar" class="btn btn-primary" />
                            </div>
                        </form>
                    </dl>
                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }