@using AdminLte.Mvc.Views.Shared.Components.Header
@using AdminLte.Mvc.Views.Shared.Components.Sidebar
@using AdminLte.Mvc.Views.Shared.Components.ControlSidebar
@using AdminLte.Mvc.Views.Shared.Components.Footer

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="x-ua-compatible" content="ie=edge">

    <title>Copy Start | @ViewData["Title"]</title>

    <link rel="icon" type="image/png" href="~/images/logo.svg" />
    <link href="//db.onlinewebfonts.com/c/e3d5ec4c7e5f3041c277d5cf3d518c71?family=Bodoni+MT+Condensed" rel="stylesheet" type="text/css" />

    @await Html.PartialAsync("Layout/_Styles.cshtml")
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="hold-transition" style="background: rgb(255,255,255);
                background: radial-gradient(circle, rgba(255,255,255,1) 8%, rgba(197,218,255,1) 100%);">
    <header class="row px-5 mx-auto" style="max-width:1400px;">
        <div class="col-3"></div>
        <div class="col-6">
            <div class="row">
                <div class="col-3">
                    <img src="~/images/favicon.png" height="90%" width="90%" />
                </div>
                <div class="col-9 d-flex align-items-center ">
                    <div class="row text-justify" style="font-family:'Bodoni MT'; font-size:5vw; color: black; line-height:80%; letter-spacing:-0.5vw">
                        <b>IMPORTACIONES <br />COPY START SAS</b>


                    </div>
                </div>
                <div class="col-12" style="height: 8px; background: rgb(32,146,254);
                        background: linear-gradient(90deg, rgba(32,146,254,1) 0%, rgba(241,38,167,1) 66%);"> </div>
                <div class="col-12 text-center" style="font-family:'Segoe Print'; font-size:1.9vw">
                    Tecnología y Calidad a Tú Servicio

                </div>

            </div>
            <div class="col-3"></div>
    </header>
    <main>
        <div class="m-auto px-3 py-4">
            <div class="container">
                <div class="row">
                    <div class="col-md-4 order-md-2 pl-3">

                        @RenderBody()

                    </div>

                    <div class="col-md-8 order-md-1">
                        <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel">
                            <ol class="carousel-indicators">
                                <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
                                <li data-target="#carouselExampleIndicators" data-slide-to="1" ></li>
                                <li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
                                <li data-target="#carouselExampleIndicators" data-slide-to="3"></li>
                            </ol>
                            <div class="carousel-inner">
                                 <div class="carousel-item active">
                                    <img class="d-block w-100" src="~/images/copystartport.png" alt="Presentacion">                                  
                                   
                                    
                                </div>

                                <div class="carousel-item">
                                    <img class="d-block w-100" src="~/images/carrusel1df.png" alt="Servicio tecnico especializado">                                  
                                   
                                    
                                </div>
                                <div class="carousel-item">
                                    <img class="d-block w-100" src="~/images/carrusel2dfv.png" alt="Gran catalogo de insumos, repuestos y maquinas">
                                     
                                </div>
                                <div class="carousel-item">
                                    <img class="d-block w-100" src="~/images/carrusel3df.png" alt="Calidad garantizada en todo momento">
                                     
                                </div>
                            </div>
                            <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="sr-only">Previous</span>
                            </a>
                            <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="sr-only">Next</span>
                            </a>
                        </div>
                    </div>




                </div>
            </div>
        </div>

        <footer class="align-bottom mx-auto" style="background: rgb(32,146,254);
                        background: linear-gradient(90deg, rgba(32,146,254,1) 0%, rgba(241,38,167,1) 66%);">

            <div class="row px-4 py-4 text-white mx-auto" style="height:auto; max-width:1400px">

                <div class="col-12 text-center">
                    <h3><b>Contactenos:</b></h3>
                    <div class="my-4">
                        <p>
                            Calle 40 No 33-24, Barrio Centro, Villavicencio, Meta <br />
                            318 874 3948 - 316 471 4891 - 666 6012  <br />
                            copystart2020@gmail.com
                        </p>
                    </div>
                </div>
            </div>
        </footer>
    </main>

    @await Html.PartialAsync("Layout/_Scripts.cshtml")
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

