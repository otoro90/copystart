@page
@model IndexModel
@{
    ViewData["Title"] = "Perfil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}





<div class="card card-primary">
    <div class="card-header">
        <h4>@ViewData["Title"]</h4>
    </div>
    <partial name="_StatusMessage" model="Model.StatusMessage" />
    <div class="card-body">
        <div class="row my-4">
            <div class="col-md-2"></div>
                <div class="col-md-8">
                    <form id="profile-form" method="post">

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="float-sm-right">
                            <div class="image">
                                <img src="/lib/admin-lte/dist/img/user2-160x160.jpg" width="130px" class="img-circle elevation-2" alt="User Image">
                            </div>
                        </div>


                        <div class="row">

                            <div class="form-group my-4 col-md-9">

                                <div class="row form-group">
                                    <div class="col-md-4">
                                        <label>Nombres</label>
                                    </div>
                                    <div class="col-md-8 text-center">
                                        <span >@Model.PersonaInput.Nombres</span>
                                        
                                    </div>

                                </div>
                                <div class="row form-group">
                                    <div class="col-md-4">
                                        <label>Apellidos</label>
                                    </div>
                                    <div class="col-md-8 text-center">
                                        <span >@Model.PersonaInput.Apellidos</span>
                                       
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col md-4">
                                        <label>
                                            Tipo de documento

                                        </label>
                                    </div>
                                    <div class=" col-md-8 text-center">
                                        <span >@Model.PersonaInput.TipoDocumento.Codigo</span>
                                        
                                    </div>
                                </div>

                                <div class="row form-group">
                                    <div class="col md-5">
                                        <label>
                                            Documento de Identidad
                                        </label>
                                    </div>
                                    <div class=" col-md-7 text-center">
                                        <span >@Model.PersonaInput.NumeroDocumento</span>
                                       
                                    </div>

                                </div>
                                <div class="row form-group">
                                    <div class="col md-4">
                                        <label>
                                            Correo electronico
                                        </label>
                                    </div>
                                    <div class=" col-md-8 text-center">
                                        <span class="collapses">@Model.Username</span>
                                        <input type="email" asp-for="Username" class="form-control collapse multi-collapse" id="multiCollapse5" disabled />
                                    </div>

                                </div>
                                <div class="row form-group">
                                    <div class="col md-4">
                                        <label>
                                            Telefono celular
                                        </label>
                                    </div>
                                    <div class=" col-md-8 text-center">
                                        <span class="collapses">@Model.PersonaInput.Telefono</span>
                                        <input type="number" asp-for="PersonaInput.Telefono" class="form-control collapse multi-collapse" id="multiCollapse6"  />
                                    </div>

                                </div>
                                <div class="row form-group">
                                    <div class="col md-4">
                                        <label>
                                            Ciudad de residencia
                                        </label>
                                    </div>
                                    <div class=" col-md-8 text-center">
                                        <span class="collapses">@Model.PersonaInput.Ciudad</span>
                                        <select class="form-control collapse multi-collapse" id="multiCollapse7" asp-for="PersonaInput.Ciudad">
                                            <option>Villavicencio</option>
                                            <option>Bogotá</option>
                                        </select>
                                    </div>

                                </div>
                                <div class="row form-group">
                                    <div class="col md-4">
                                        <label>
                                            Direccion
                                        </label>
                                    </div>
                                    <div class=" col-md-8 text-center">
                                        <span class="collapses">@Model.PersonaInput.Direccion</span>
                                        <input type="text" class="form-control collapse multi-collapse" id="multiCollapse8"  asp-for="PersonaInput.Direccion">
                                    </div>

                                </div>
                                <div>

                                    <button class="btn btn-primary " type="button" id="btntoggle" data-toggle="collapse" data-target=".multi-collapse" aria-expanded="false"
                                            aria-controls=" multiCollapse5 multiCollapse6 multiCollapse7 multiCollapse8  update-profile-button" onclick="alternarInput()">
                                        Editar
                                    </button>

                                    <button class="btn btn-primary collapse multi-collapse" id="update-profile-button" type="submit">Guardar</button>
                                </div>

                            </div>

                        </div>








                    </form>

                </div>
            </div>
        </div>

</div>
 

<script >
    function alternarInput() {
        document.querySelectorAll("span.collapses").forEach(x => x.classList.toggle("d-none"))

    }

</script>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}