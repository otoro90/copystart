@page
@model IndexModel
@{
    ViewData["Title"] = "Perfil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}


<div class="card card-primary">
    <div class="card-header">
        <h4>@ViewData["Title"]</h4>
    </div>
    <partial name="_StatusMessage" model="Model.StatusMessage" />
    <div class="card-body">
        <div class="row my-4">
            <div class="col-md-2"></div>
                <div class="col-md-8">
                    <form id="profile-form" method="post">

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="float-sm-right">
                            <div class="image">
                                <img src="/lib/admin-lte/dist/img/user2-160x160.jpg" width="130px" class="img-circle elevation-2" alt="User Image">
                            </div>
                        </div>


                        <div class="row">

                            <div class="form-group my-4 col-md-9">

                                <div class="row form-group">
                                    <div class="col-md-4">
                                        <label>Nombres</label>
                                    </div>
                                    <div class="col-md-8 text-center">
                                        <p class="collapses">Haider Johan</p>
                                        <input type="text" class="form-control collapse multi-collapse" placeholder="Haider Johan" id="multiCollapse1">
                                    </div>

                                </div>
                                <div class="row form-group">
                                    <div class="col-md-4">
                                        <label>Apellidos</label>
                                    </div>
                                    <div class="col-md-8 text-center">
                                        <p class="collapses">Arango Diaz</p>
                                        <input type="text" class="form-control collapse multi-collapse" placeholder="Arango Diaz" id="multiCollapse2">
                                    </div>
                                </div>
                                <div class="row form-group">
                                    <div class="col md-4">
                                        <label>
                                            Tipo de documento

                                        </label>
                                    </div>
                                    <div class=" col-md-8 text-center">
                                        <p class="collapses">TI</p>
                                        <select class="form-control collapse multi-collapse" disabled="" id="multiCollapse3">
                                            <option>TI</option>
                                            <option>CC</option>
                                            <option>CE</option>
                                            <option>Pasaporte</option>
                                            <option>option 5</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="row form-group">
                                    <div class="col md-5">
                                        <label>
                                            Documento de Identidad
                                        </label>
                                    </div>
                                    <div class=" col-md-7 text-center">
                                        <p class="collapses">1003649777</p>
                                        <input type="text" class="form-control collapse multi-collapse" placeholder="1003649777" id="multiCollapse4" disabled="">
                                    </div>

                                </div>
                                <div class="row form-group">
                                    <div class="col md-4">
                                        <label>
                                            Correo electronico
                                        </label>
                                    </div>
                                    <div class=" col-md-8 text-center">
                                        <p class="collapses">hjarangod@gmail.com</p>
                                        <input type="email" asp-for="Username" class="form-control collapse multi-collapse" id="multiCollapse5" disabled />
                                    </div>

                                </div>
                                <div class="row form-group">
                                    <div class="col md-4">
                                        <label>
                                            Telefono celular
                                        </label>
                                    </div>
                                    <div class=" col-md-8 text-center">
                                        <p class="collapses">3194275519</p>
                                        <input type="number" asp-for="Input.PhoneNumber" class="form-control collapse multi-collapse" id="multiCollapse6" value="3194275519" />
                                    </div>

                                </div>
                                <div class="row form-group">
                                    <div class="col md-4">
                                        <label>
                                            Ciudad de residencia
                                        </label>
                                    </div>
                                    <div class=" col-md-8 text-center">
                                        <p class="collapses">Villavicencio</p>
                                        <select class="form-control collapse multi-collapse" id="multiCollapse7">
                                            <option>Villavicencio</option>
                                        </select>
                                    </div>

                                </div>
                                <div class="row form-group">
                                    <div class="col md-4">
                                        <label>
                                            Direccion
                                        </label>
                                    </div>
                                    <div class=" col-md-8 text-center">
                                        <p class="collapses">Calle 24 sur n42a 18</p>
                                        <input type="text" class="form-control collapse multi-collapse" id="multiCollapse8" placeholder="Calle 24 sur n42a 18">
                                    </div>

                                </div>
                                <div>

                                    <button class="btn btn-primary " type="button" id="btntoggle" data-toggle="collapse" data-target=".multi-collapse" aria-expanded="false"
                                            aria-controls="multiCollapse1 multiCollapse2 multiCollapse3 multiCollapse4 multiCollapse5 multiCollapse6 multiCollapse7 multiCollapse8  update-profile-button" onclick="alternarInput()">
                                        Editar
                                    </button>

                                    <button class="btn btn-primary collapse multi-collapse" id="update-profile-button" type="submit">Guardar</button>
                                </div>

                            </div>

                        </div>








                    </form>

                </div>
            </div>
        </div>

</div>
 
<script>
    const btn = document.getElementById('btntoggle');

  
    btn.addEventListener('click', function handleClick() {
        const initialText = 'Editar';
       
        if (btn.textContent.toLowerCase().includes(initialText.toLowerCase())) {
            btn.textContent = 'Cancelar';
            btn.classList.toggle("btn-primary").toggle("btn btn-default bg-gray");
        } else {
            btn.textContent = initialText;
            btn.classList.toggle("btn-primary").toggle("btn btn-default bg-gray");
        }
    });

</script>
<script >
    function alternarInput() {
        document.querySelectorAll("p.collapses").forEach(x => x.classList.toggle("d-none"))

    }

</script>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}