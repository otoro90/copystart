@page
@model IndexModel
@{
    ViewData["Title"] = "Perfil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h4>@ViewData["Title"]</h4>
<partial name="_StatusMessage" model="Model.StatusMessage" />

<div class="row">
    <div class="col-md-12">
        <form id="profile-form" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">

                <div class="form-group my-4 col-md-9">

                    <div class="row form-group">
                        <div class="col-md-4">
                            <label>Nombres</label>
                        </div>
                        <div class="col-md-8 text-center">
                            <p>Haider Johan</p>
                            <input type="text" class="form-control d-none" placeholder="Nombre">
                        </div>
                    </div>

                    <div class="row form-group">
                        <div class="col-md-4">
                            <label>Apellidos</label>
                        </div>
                        <div class="col-md-8 text-center">
                            <p>Arango Diaz</p>
                            <input type="text" class="form-control d-none" placeholder="Apellidos">
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col md-4">
                            <label>
                                Tipo de documento

                            </label>
                        </div>
                        <div class=" col-md-8 text-center">
                            <p>TI</p>
                            <select class="form-control d-none" disabled="">
                                <option>TI</option>
                                <option>CC</option>
                                <option>CE</option>
                                <option>Pasaporte</option>
                                <option>option 5</option>
                            </select>
                        </div>

                    </div>

                    <div class="row form-group">
                        <div class="col md-5">
                            <label>
                                Documento de Identidad
                            </label>
                        </div>
                        <div class=" col-md-7 text-center">
                            <p>1003649777</p>
                            <input type="text" class="form-control d-none" placeholder="1003649777" disabled="">
                        </div>

                    </div>
                    <div class="row form-group">
                        <div class="col md-4">
                            <label>
                                Correo electronico
                            </label>
                        </div>
                        <div class=" col-md-8 text-center">
                            <label asp-for="Username"></label>
                            <input type="email" asp-for="Username" class="form-control d-none" disabled />
                        </div>

                    </div>
                    <div class="row form-group">
                        <div class="col md-4">
                            <label>
                                Telefono celular
                            </label>
                        </div>
                        <div class=" col-md-8 text-center">
                            <label asp-for="Input.PhoneNumber"></label>
                            <input type="number" asp-for="Input.PhoneNumber" class="form-control d-none" />
                        </div>

                    </div>
                    <div class="row form-group">
                        <div class="col md-4">
                            <label>
                                Ciudad de residencia
                            </label>
                        </div>
                        <div class=" col-md-8 text-center">
                            <p>Villavicencio</p>
                            <select class="form-control d-none">
                                <option>Villavicencio</option>
                            </select>
                        </div>

                    </div>
                    <div class="row form-group">
                        <div class="col md-4">
                            <label>
                                Direccion
                            </label>
                        </div>
                        <div class=" col-md-8 text-center">
                            <p>Calle 24 Sur #42a-18</p>
                            <input type="text" class="form-control d-none" placeholder="Dirección">
                        </div>

                    </div>


                </div>
                <div class="form-group col-md-3">
                    <div class="image">
                        <img src="/lib/admin-lte/dist/img/user2-160x160.jpg" width="130px" class="img-circle elevation-2" alt="User Image">
                    </div>
                </div>
            </div>
            <button class="btn btn-primary">Editar</button>
            <button class="btn btn-primary d-none">Cancelar</button>
            <button id="update-profile-button" type="submit" class="btn btn-primary d-none">Guardar</button>
            
        </form>

    </div>
    </div>
    
  


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}