@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "You forgot your password? Here you can easily retrieve a new password.";
}



<div class="login-logo">
    <a asp-page="/Home/Index"><b>Admin</b>LTE</a>
</div>
<!-- /.login-logo -->
<div class="card">
    <div class="card-body login-card-body">
        <p class="login-box-msg">@ViewData["Title"]</p>

        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="input-group mb-3">
                <input asp-for="Input.Email" placeholder="@Html.DisplayNameFor(m => m.Input.Email)" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
                <div class="input-group-append">
                    <div class="input-group-text">
                        <span class="fas fa-envelope"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <button type="submit" class="btn btn-primary btn-block">Request new password</button>
                </div>
                <!-- /.col -->
            </div>
        </form>

        <p class="mt-3 mb-1">
            <a asp-page="./Login">Login</a>
        </p>
        <p class="mb-0">
            <a class="text-center" asp-page="./Register">Register a new membership</a>
        </p>
    </div>
    <!-- /.login-card-body -->
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
