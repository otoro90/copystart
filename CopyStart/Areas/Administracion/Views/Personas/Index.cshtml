@model IEnumerable<CopyStart.Entities.ApplicationUserRole>

@{
    ViewData["Title"] = "Listado de personas";
}

<div class="row">
<div class="col-12">

        <div class="card">
            <div class="card-header">
              
</div>
            <div class="card-body">
                <table class="table table-bordered table-hover text-center" id="table-personas">                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.User.Persona.Nombres)</th>
                            <th>@Html.DisplayNameFor(model => model.User.Persona.Apellidos)</th>
                            <th>@Html.DisplayNameFor(model => model.User.Persona.NumeroDocumento)</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
 var documento = $"{item.User.Persona.TipoDocumento.Codigo} {item.User.Persona.NumeroDocumento}";
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.User.Persona.Nombres)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.User.Persona.Apellidos)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => documento)
                                </td>
                                <td>
                                    @if (item.RoleId == "TEC")
                                    {
                                        @Html.DisplayFor(modelItem => item.User.Persona.Estado) // Colocar el estado del tecnico
@Html.DisplayFor(modelItem => item.User.Estado)
                                    }
                                    else
                                    {
                                        @*@Html.DisplayFor(modelItem => item.User.Estado) //Colocar el estado del usuario --> Activo e Inactivo --> Se debe agregar un campo estado al usuario*@
                                    }
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.User.PersonaId" role="button" class="btn btn-default bg-primary"><i class="fas fa-pen"></i></a>
                                    <a asp-action="Details" asp-route-id="@item.User.PersonaId" role="button" class="btn btn-default bg-secondary"><i class="far fa-file"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.User.PersonaId" role="button" class="btn btn-default bg-danger"><i class="far fa-trash-alt"></i></a>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>




















