@model CopyStart.Entities.Persona

@{
    ViewData["Title"] = "Details";
    var urlCliente= "/Activos/Activos/ActivosPorCliente?idCliente=" + Model.Id;
   
}


   <div class="row ml-3">
        <a asp-action="Index"> 
            <button  type="button" class="btn btn-default bg-blue">
           <i class="fas fa-angle-left"></i>
            
            
            </button>
            <p> Volver</p>
            </a>
   </div>  

<div class="row">
    <div class="col-md-3">
    </div>
    <div class="col-md-6 card">
        <div class="card-header row">
            <h4 class="col-md-6">Detalles de persona</h4>

            <div class="col-6">
                <div class="col-md-12">
                    <button type="button" class="btn btn-block btn-default btn-sm"><a asp-action="Edit" asp-route-id="@Model.Id">Editar</a> </button>
                </div>
                <div class="col-md-12">
                    <button type="button" class="btn btn-block btn-default btn-sm"><a asp-action="Index">Volver</a> </button>
                </div>
                <div class="col-md-12">
                    <button type="button" class="btn btn-block btn-default btn-sm"><a href="@urlCliente">Ver Activos</a> </button>
                </div>

            </div>
        </div>
    
    <div class="card-body">
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nombres)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nombres)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Apellidos)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Apellidos)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TipoDocumento)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TipoDocumento.Codigo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NumeroDocumento)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NumeroDocumento)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Direccion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Direccion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Ciudad)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Ciudad)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Telefono)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Telefono)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Estado)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Estado)
        </dd>
    </dl>
    </div>
    </div>
    <div class="col-md-3"></div>
</div>