@model CopyStart.Entities.Persona

@{
    ViewData["Title"] = "Detalles de persona";
    var urlCliente= "/Activos/Activos/ActivosPorCliente?idCliente=" + Model.Id;
   
}



<div class="row justify-content-center">
    
    <div class="col-md-12 card">
        <div class="card-header">
            <div class="row mb-3">
                <b>Información detallada de la persona</b>
            </div>

            <div class="row">
                <div class="col-md-3 my-2">
                   <a  asp-action="Index" role="button" class="btn btn-block btn-default btn-sm">Volver</a>
                </div>
                 @if (User.IsInRole("Administrador"))
                {
                    <div class="col-md-3 my-2">
                        <a  asp-action="Edit" asp-route-id="@Model.Id" role="button" class="btn btn-block btn-default btn-sm">Editar</a>
                </div>}

                @if ((Model.Users.Any(x => x.UserRoles.Where(p=>p.RoleId == "CLN").Count()>0 ))||(Model.Users.Count()==0))
                {
                    <div class="col-md-3 my-2">
                        <a  href="@urlCliente" role="button" class="btn btn-block btn-default btn-sm">Ver activos</a>  
                    </div>
                }

                @if (User.IsInRole("Administrador"))
                {
                    <div class="col-md-3 my-2">
                        <a  asp-action="AsignarRol" asp-route-id="@Model.Id" role="button" class="btn btn-block btn-default btn-sm">Asignar rol</a>
                    </div>
                }

                @if ((Model.Users.Any(x => x.UserRoles.Where(p=>p.RoleId == "CLN").Count()>0 )) && (Model.Estado == "En servicio"))
                {
                    <div class="col-md-3 my-2">
                        <a  asp-action="VerServicio" asp-route-id="@Model.Id" role="button" class="btn btn-block btn-default btn-sm">Ver servicio</a>
                    </div>
                }
            </div>
        </div>

        <div class="card-body">
            <h2>Datos de persona</h2>
            <dl class="row my-4">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Nombres)
                </dt>
                <dd class="col-sm-4">
                    @Html.DisplayFor(model => model.Nombres)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Apellidos)
                </dt>
                <dd class="col-sm-4">
                    @Html.DisplayFor(model => model.Apellidos)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.TipoDocumento)
                </dt>
                <dd class="col-sm-4">
                    @Html.DisplayFor(model => model.TipoDocumento.Codigo)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.NumeroDocumento)
                </dt>
                <dd class="col-sm-4">
                    @Html.DisplayFor(model => model.NumeroDocumento)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Direccion)
                </dt>
                <dd class="col-sm-4">
                    @Html.DisplayFor(model => model.Direccion)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Ubicacion.Municipio)
                </dt>
                <dd class="col-sm-4">
                    @Html.DisplayFor(model => model.Ubicacion.Municipio), @Html.DisplayFor(model => model.Ubicacion.Departamento) 
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Telefono)
                </dt>
                <dd class="col-sm-4">
                    @Html.DisplayFor(model => model.Telefono)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Estado)
                </dt>
                <dd class="col-sm-4">
                    @Html.DisplayFor(model => model.Estado)
                </dd>
            </dl>

             @if (User.IsInRole("Administrador"))
            {
                <h2>Roles de persona</h2>

                <div class="row my-4">
                    <div class="col-6">
                    <table class="table table-bordered table-hover">

                        <tbody>
                            @foreach (var item in Model.Users)
                            {
                                @foreach (var rol in item.UserRoles)
                                {
                                    <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => rol.Role.Name)
                                        </td>
                                        <td class="float-right">

                                            <a asp-action="BorrarRol" asp-route-id="@rol.Role.Id" asp-route-user="@item.PersonaId" role="button" class="btn btn-default bg-blue"><i class="far fa-trash-alt"></i></a>
                                        </td>


                                    </tr>
                                }
                            }
                        </tbody>
                </table>

            </div>
            </div>
            }
        
    </div>

</div>







