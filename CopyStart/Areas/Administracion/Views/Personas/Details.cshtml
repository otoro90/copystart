@model CopyStart.Areas.Administracion.Models.DetallePersonaVM

@{
    ViewData["Title"] = "Detalles de persona";
    var urlCliente= "/Activos/Activos/ActivosPorCliente?idCliente=" + Model.Persona.Id;
   
}



<div class="row">
    <div class="col-md-3">
    </div>
    <div class="col-md-6 card">
        <div class="card-header">
            <h4 class="col-md-12">Detalles de persona</h4>

            <div class="row">
                <div class="col-md-3 my-2">
                   <a  asp-action="Index" role="button" class="btn btn-block btn-default btn-sm">Volver</a>
                </div>
                <div class="col-md-3 my-2">
                    <a  asp-action="Edit" asp-route-id="@Model.Persona.Id" role="button" class="btn btn-block btn-default btn-sm">Editar</a>
                </div>
                @if (Model.RolesUsuario.Where(x => x.Role.Id == "CLN").Count()>0)
                {
                    <div class="col-md-3 my-2">
                        <a  href="@urlCliente" role="button" class="btn btn-block btn-default btn-sm">Ver activos</a>  
                    </div>
                }

                @if (User.IsInRole("Administrador"))
                {
                    <div class="col-md-3 my-2">
                        <a  asp-action="AsignarRol" asp-route-id="@Model.Persona.Id" role="button" class="btn btn-block btn-default btn-sm">Asignar rol</a>
                    </div>
                }

                @if ((Model.RolesUsuario.Where(x => x.Role.Id == "TEC").Count() > 0) && (Model.Persona.Estado == "En servicio"))
                {
                    <div class="col-md-3 my-2">
                        <a  asp-action="VerServicio" asp-route-id="@Model.Persona.Id" role="button" class="btn btn-block btn-default btn-sm">Ver servicio</a>
                    </div>
                }
            </div>
        </div>

        <div class="card-body">
            <h2>Datos de persona</h2>
            <dl class="row my-4">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Persona.Nombres)
                </dt>
                <dd class="col-sm-4">
                    @Html.DisplayFor(model => model.Persona.Nombres)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Persona.Apellidos)
                </dt>
                <dd class="col-sm-4">
                    @Html.DisplayFor(model => model.Persona.Apellidos)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Persona.TipoDocumento)
                </dt>
                <dd class="col-sm-4">
                    @Html.DisplayFor(model => model.Persona.TipoDocumento.Codigo)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Persona.NumeroDocumento)
                </dt>
                <dd class="col-sm-4">
                    @Html.DisplayFor(model => model.Persona.NumeroDocumento)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Persona.Direccion)
                </dt>
                <dd class="col-sm-4">
                    @Html.DisplayFor(model => model.Persona.Direccion)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Persona.Ubicacion.Lugar)
                </dt>
                <dd class="col-sm-4">
                    @Html.DisplayFor(model => model.Persona.Ubicacion.Lugar)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Persona.Telefono)
                </dt>
                <dd class="col-sm-4">
                    @Html.DisplayFor(model => model.Persona.Telefono)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Persona.Estado)
                </dt>
                <dd class="col-sm-4">
                    @Html.DisplayFor(model => model.Persona.Estado)
                </dd>
            </dl>

             @if (User.IsInRole("Administrador"))
            {
                <h2>Roles de persona</h2>

                <div class="row my-4">
                    <table class="col-6">

                        <tbody>
                            @foreach (var item in Model.RolesUsuario)
                            {
                                <tr>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Role.Name)
                                    </td>
                                    <td class="float-right">

                                        <a  asp-action="BorrarRol" asp-route-id="@item.Role.Id" asp-route-user="@item.User.PersonaId" role="button" class="btn btn-default bg-blue"><i class="far fa-trash-alt"></i></a>
                                    </td>


                                </tr>
                            }
                        </tbody>
                </table>

            </div>
            }
        </div>
    </div>
    <div class="col-md-3"></div>
</div>







