@model IEnumerable<CopyStart.Entities.ProcedimientoTipoServicio>

@{
    ViewData["Title"] = "Index";
    
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Numero)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Procedimientos)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TipoServicio)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Numero)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Procedimientos.Codigo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TipoServicio.Codigo)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ProcedimientoId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.TipoServicioId" asp-route-username="@item.ProcedimientoId">Details</a> |
                <a asp-action="Delete" asp-route-id1="@item.TipoServicioId" asp-route-id2="@item.ProcedimientoId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
