@model IEnumerable<CopyStart.Entities.ProcedimientoTipoServicio>

@{
    ViewData["Title"] = "Procedimientos";
    var urlTipoServicios = "/Administracion/ProcedimientoTipoServicios/?tipoServicioId=" + ViewData["TipoServicioId"];
}


    <div class="col-12">
        <div class="card">

            <div class="card-body table-responsive">

                <table class="table table-bordered table-hover text-center" id="table-procedimientots">

                    <thead >
                        <tr>

                             <div class="col-12 mb-2">
                                <a asp-action="Create"  asp-route-tipoServicioId="@ViewData["TipoServicioId"]" class="btn btn-default bg-primary" role="button">
                                    Registrar
                                </a>
                            </div>



                            <th>
                                @Html.DisplayNameFor(model => model.Numero)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.TipoServicio)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Procedimientos.Nombre)
                            </th>
                             <th>
                                @Html.DisplayNameFor(model => model.Procedimientos.Descripcion)
                            </th>
                             <th>
                                @Html.DisplayNameFor(model => model.Procedimientos.TiempoEjecucion)
                            </th>

                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Numero)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.TipoServicio.Nombre)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Procedimientos.Nombre)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Procedimientos.Descripcion)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Procedimientos.TiempoEjecucion)
                                </td>
                                <td>
                                   <a asp-action="Edit" asp-route-id="@item.Id" role="button" class="btn btn-default bg-primary"><i class="fas fa-pen"></i></a>

                                <a asp-action="Details" asp-route-id="@item.Id" role="button" class="btn btn-default bg-secondary"><i class="far fa-file"></i></a>

                                <a asp-action="Delete" asp-route-id="@item.Id" role="button" class="btn btn-default bg-danger"><i class="far fa-trash-alt"></i></a>


                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

