@model IEnumerable<CopyStart.Entities.ProcedimientoTipoServicio>

@{
    ViewData["Title"] = "Procedimientos";
    var urlTipoServicios = "/Administracion/ProcedimientoTipoServicios/?tipoServicioId=" + ViewData["TipoServicioId"];
}




<div class="row ml-3 mb-2">
    <a asp-action="Create" asp-route-tipoServicioId="@ViewData["TipoServicioId"]" class="btn btn-default bg-blue" role="button">
        <i class="fas fa-plus mr-3"></i>
    </a>
</div>




    <div class="col-12">
        <div class="card">

            <div class="card-body ">

                <table class="table table-bordered table-hover text-center" id="table-procedimientots">

                    <thead >
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.Numero)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.TipoServicio)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Procedimientos.Nombre)
                            </th>

                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Numero)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.TipoServicio.Codigo)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Procedimientos.Nombre)
                                </td>

                                <td>
                                   <a asp-action="Edit" asp-route-id="@item.Id" role="button" class="btn btn-default bg-blue"><i class="fas fa-pen"></i></a>

                                <a asp-action="Details" asp-route-id="@item.Id" role="button" class="btn btn-default bg-blue"><i class="far fa-file"></i></a>

                                <a asp-action="Delete" asp-route-id="@item.Id" role="button" class="btn btn-default bg-blue"><i class="far fa-trash-alt"></i></a>


                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

