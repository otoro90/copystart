@model IEnumerable<CopyStart.Entities.ProcedimientoTipoServicio>

@{
    ViewData["Title"] = "Index";
}




<div class="row ml-3 mb-2">
    <a asp-action="Create">
        <button type="button" class="btn btn-default bg-blue">
            <i class="fas fa-plus mr-3"></i>
        </button>
    </a>
</div>



<div class="row ">
    <div class="col-12">
        <div class="card">


            <div class="card-body table-responsive p-0">

                <table class="table  table-hover text-nowrap">

                    <thead class="bg-blue">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.Numero)
                            </th>
                             <th>
                                @Html.DisplayNameFor(model => model.TipoServicio)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Procedimientos)
                            </th>
                           
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Numero)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.TipoServicio.Codigo)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Procedimientos.Codigo)
                                </td>
                                
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id">
                                        <button type="button" class="btn btn-default bg-blue"><i class="far fa-file"></i></button>
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@item.Id">
                                        <button type="button" class="btn btn-default bg-blue">


                                            <i class="fas fa-pen"></i>
                                        </button>
                                    </a>


                                    <a asp-action="Delete" asp-route-id="@item.Id">
                                        <button type="button" class="btn btn-default bg-blue">
                                            <i class="far fa-trash-alt"></i>
                                        </button>
                                    </a>


                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
