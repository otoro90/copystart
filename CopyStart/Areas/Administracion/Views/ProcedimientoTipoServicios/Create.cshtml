@model CopyStart.Entities.ProcedimientoTipoServicio

@{
    ViewData["Title"] = "Create";
}


<div class="row">
    <div class="col-md-3 "></div>

    <div class="col-md-6">
        <div class="mt-3">
            <div class="ml-3">
                <div class="card card-primary">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-8 my-2 text-center">
                                <h2 class="card-title"><b>Crear Persona</b></h2>
                            </div>
                            <div class="col-md-4 my-2">
                                <button type="button" class="btn btn-block btn-sm bg-gradient-navy"><a asp-action="Index">Volver </a> </button>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        <form asp-action="Create">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <div class="form-group">
                                <label asp-for="Numero" class="control-label"></label>
                                <input asp-for="Numero" class="form-control" />
                                <span asp-validation-for="Numero" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="ProcedimientoId" class="control-label"></label>
                                <select asp-for="ProcedimientoId" class="form-control" asp-items="ViewBag.ProcedimientoId"></select>
                            </div>
                            <div class="form-group">
                                <label asp-for="TipoServicioId" class="control-label"></label>
                                <select asp-for="TipoServicioId" class="form-control" asp-items="ViewBag.TipoServicioId"></select>
                            </div>
                            <div class="form-group">
                                <input type="submit" value="Create" class="btn btn-primary" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 "></div>
</div>


@section Scripts {
    @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
}