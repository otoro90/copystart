@model CopyStart.Areas.Administracion.Models.ProcedimientoCrear

@{
    ViewData["Title"] = "Crear procedimiento";
}


<div class="row justify-content-center">
   

    <div class="col-md-12">
        <div class="mt-3">
            <div class="ml-3">
                <div class="card card-primary">
                   
                    <div class="card-body">
                        <form asp-action="Create">
                            <div class="row">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                           
                            
                            <div class="form-group col-md-6">
                                <label asp-for="TipoServicioId" class="control-label"></label>
                                <select asp-for="TipoServicioId" class="form-control select2" asp-items="ViewBag.TipoServicioId">
                                    <option></option>
                                </select>
                            </div>
                             <div class="form-group col-md-6">
                               <label asp-for="Numero" class="control-label"></label>
                                <input asp-for="Numero" min="1" class="form-control" />
                                <span asp-validation-for="Numero" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Nombre" class="control-label"></label>
                                <input asp-for="Nombre" class="form-control" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-12">
                                <label asp-for="Descripcion" class="control-label"></label>
                                @Html.TextAreaFor(modelItem => modelItem.Descripcion, new { style = "width: 100%; height: 50px ", @class = "form-control" })
                                <span asp-validation-for="Descripcion" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Codigo" class="control-label"></label>
                                <input asp-for="Codigo" class="form-control" />
                                <span asp-validation-for="Codigo" class="text-danger"></span>
                            </div>
                             <div class="form-group col-md-6">
                                <label asp-for="TiempoEjecucion" class="control-label"></label>
                                <input asp-for="TiempoEjecucion" class="form-control" />
                                <span asp-validation-for="TiempoEjecucion" class="text-danger"></span>
                            </div>
                            <div class="form-group form-check col-md-6">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="Estado" /> @Html.DisplayNameFor(model => model.Estado)
                                </label>
                            </div>


                            <div class="form-group col-md-12">
                                <input type="submit" value="Crear" class="btn btn-primary float-right" />
                            </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
  
</div>


@section Scripts {
    @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
}