@model CopyStart.Areas.Administracion.Models.ProcedimientoCrear

@{
    ViewData["Title"] = "Editar procedimiento";
}


<div class="row justify-content-center">

    <div class="col-md-6">
        <div class="mt-3">
            <div class="ml-3">
                <div class="card card-primary">
                   <div class="card-header">Formulario de edición de procedimientos</div>
                    <div class="card-body">
                        <form asp-action="Edit">
                            <div class="row">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <input type="hidden" asp-for="Id" />
                             <div class="form-group">                             
                                <select asp-for="TipoServicioId" class="form-control" asp-items="ViewBag.TipoServicioId" hidden></select>                              
                            </div>
                              <div class="form-group">                             
                                <select asp-for="ProcedimientoId" class="form-control" asp-items="ViewBag.ProcedimientoId" hidden></select>                              
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Numero" class="control-label"></label>
                                <input asp-for="Numero" class="form-control" />
                                <span asp-validation-for="Numero" class="text-danger"></span>
                            </div>                           
                           
                           
                            <div class="form-group col-md-6">
                                <label asp-for="Nombre" class="control-label"></label>
                                <input asp-for="Nombre" class="form-control" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-12">
                                <label asp-for="Descripcion" class="control-label"></label>
                                @Html.TextAreaFor(modelItem => modelItem.Descripcion, new { style = "width: 100%; height: 50px ", @class = "form-control" })
                                <span asp-validation-for="Descripcion" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Codigo" class="control-label"></label>
                                <input asp-for="Codigo" class="form-control" />
                                <span asp-validation-for="Codigo" class="text-danger"></span>
                            </div>
                             <div class="form-group col-md-6">
                                <label asp-for="TiempoEjecucion" class="control-label"></label>
                                <input asp-for="TiempoEjecucion" class="form-control" />
                                <span asp-validation-for="TiempoEjecucion" class="text-danger"></span>
                            </div>
                            <div class="form-group form-check col-md-4">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="Estado" /> @Html.DisplayNameFor(model => model.Estado)
                                </label>
                            </div>
                               

                            <div class="form-group col-md-12">
                                <button type="button" class="btn btn-default"> <a asp-action="Index" asp-route-tipoServicioId="@Model.TipoServicioId">Volver</a></button>
                                <input type="submit" value="Guardar" class="btn btn-primary float-right" />
                            </div>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }