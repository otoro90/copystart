@model CopyStart.Entities.ProcedimientoTipoServicio

@{
    ViewData["Title"] = "Detalles de procedimiento";
}



<div class="row">
    <div class="col-md-3">
    </div>
    <div class="col-md-6 card">


        <div class="card-body">

            <dl class="row my-4">
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Numero)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Numero)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.TipoServicio)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.TipoServicio.Nombre)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Procedimientos)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Procedimientos.Nombre)
                </dd>

                <dt  class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Procedimientos.Descripcion)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Procedimientos.Descripcion)
                </dd>
                 <dt  class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Procedimientos.Codigo)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Procedimientos.Codigo)
                </dd>

                <dt  class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Procedimientos.TiempoEjecucion)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Procedimientos.TiempoEjecucion)
                </dd>

            </dl>


        </div>
    </div>
    <div class="col-md-3"></div>
</div>