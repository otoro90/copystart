@model IEnumerable<CopyStart.Entities.ServicioProcedimientoTipoServicio>

@{
    ViewData["Title"] = "Listado de procedimientos";
}



<div class="row ">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover text-center" id="table-proser">
                        <thead>
                            <tr>
                                <th id="id" class="d-none">
                                    @Html.DisplayNameFor(model => model.Id)
                                </th>
                                <th id="servicioId" class="d-none">
                                    @Html.DisplayNameFor(model => model.ServicioId)
                                </th>
                                <th id="procedimientoTipoServicioId" class="d-none">
                                    @Html.DisplayNameFor(model => model.ProcedimientoTipoServicioId)
                                </th>
                                <th id="procedimientosRealizados" class="d-none">
                                    @Html.DisplayNameFor(model => model.ProcedimientosRealizados)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.ProcedimientoTipoServicio.Numero)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.ProcedimientoTipoServicio.Procedimientos.Nombre)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.ProcedimientoTipoServicio.Procedimientos.Descripcion)
                                </th>
                                <th>
                                    @Html.DisplayName("Tiempo de ejecución")
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.ProcedimientosRealizados)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Observaciones)
                                </th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td id="id" class="d-none">
                                        @Html.DisplayFor(modelItem => item.Id)
                                    </td>
                                    <td id="servicioId" class="d-none">
                                        @Html.DisplayFor(modelItem => item.ServicioId)
                                    </td>
                                    <td id="procedimientoTipoServicioId" class="d-none">
                                        @Html.DisplayFor(modelItem => item.ProcedimientoTipoServicioId)
                                    </td>
                                    <td id="procedimientosRealizados" class="d-none">
                                        @item.ProcedimientosRealizados
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.ProcedimientoTipoServicio.Numero)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.ProcedimientoTipoServicio.Procedimientos.Nombre)
                                    </td>
                                    <td style="line-height: 1.1; font-size: 0.9rem; ">
                                        @Html.DisplayFor(modelItem => item.ProcedimientoTipoServicio.Procedimientos.Descripcion)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.ProcedimientoTipoServicio.Procedimientos.TiempoEjecucion) minutos
                                    </td>
                                    <td>
                                        <div class="custom-control custom-checkbox checkbox-xl">
                                            @Html.CheckBoxFor(modelItem => item.ProcedimientosRealizados, new { style = "-ms-transform: scale(2.5);-moz-transform: scale(2.5);-webkit-transform: scale(2.5);-o-transform: scale(2.5);transform: scale(2.5);margin-top: 25px; margin-left:-20px" })
                                        </div>
                                    </td>
                                    <td>
                                        @Html.TextAreaFor(modelItem => item.Observaciones, new { style = "width: 100%; height: 60px " })
                                    </td>
                                </tr>

                            }
                        </tbody>
                    </table>
                </div>
                <div class="form-group">
                    <div class="form-group">
                        <input onclick="EjecucionProcedimientos.registrarProcedimientosRealizados()" type="submit" value="Guardar" class="btn btn-primary float-right" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
