@model CopyStart.Entities.Servicio

@{
    ViewData["Title"] = "Editar";
}


<div class="row justify-content-center">

    <div class="col-md-12">
        <div class="mt-3">

            <div class="card card-primary">

                <div class="card-body">
                    <h2>Datos de persona</h2>
                    <dl class="row my-4">

                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Activo)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Activo.TipoActivo.Nombre) @Html.DisplayFor(model => model.Activo.MarcaActivo.Nombre)  @Html.DisplayFor(model => model.Activo.ModeloActivo.Nombre)  S/N:  @Html.DisplayFor(model => model.Activo.Serial)
                        </dd>

                        <dt class="col-sm-2">
                            Cliente
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Activo.Persona.Nombres) @Html.DisplayFor(model => model.Activo.Persona.Apellidos)
                        </dd>
                        <dt class="col-sm-2">
                            Tecnico
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Solicitudes.Tecnico.Nombres) @Html.DisplayFor(model => model.Solicitudes.Tecnico.Apellidos)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Solicitudes)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Solicitudes.Incidencia)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Estado)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Estado)
                        </dd>
                        @if (Model.Estado == "En ejecucion")
                        {
                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.FechaInicio)
                            </dt>
                            <dd class="col-sm-10">
                                @Html.DisplayFor(model => model.FechaInicio)
                            </dd>
                        }
                        @if (Model.Estado == "Finalizado")
                        {
                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.FechaFinalizacion)
                            </dt>
                            <dd class="col-sm-10">
                                @Html.DisplayFor(model => model.FechaFinalizacion)
                            </dd>
                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.Observaciones)
                            </dt>
                            <dd class="col-sm-10">
                                @Html.DisplayFor(model => model.Observaciones)
                            </dd>
                        }


                    </dl>

                    <dl>
                        <form asp-action="AgregarObservaciones">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <input type="hidden" asp-for="Id" />
                            <div class="form-group">
                                <label> Agrega detalles sobre la realizacion del servicio (repuestos usados, pendientes a futuro, estado de la maquina al final del servicio), se veran reflejados cuando termine el servicio</label>
                                 @Html.TextAreaFor(modelItem => modelItem.Observaciones, new { style = "width: 100%; height: 70px ", @class = "form-control" })
                                <span asp-validation-for="Observaciones" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <input type="submit" value="Guardar" class="btn btn-primary" />
                            </div>
                        </form>
                    </dl>
                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }