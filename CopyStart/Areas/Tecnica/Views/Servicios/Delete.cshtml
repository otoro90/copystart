@model CopyStart.Entities.Servicio

@{
    ViewData["Title"] = "Borrar servicio";
}



<div class="row">
    <div class="col-md-3 "></div>

         <div class="col-md-6">
             <div class="mt-3">
                  <div class="ml-3">
                      <div class="card card-primary">
                           <div class="card-header bg-red">
                                <h2 class="card-title"><b>¿Quieres borrar este servicio?</b></h2>
                      </div>

                   
                      <div class="card-body">
                              <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Estado)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Estado)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaInicio)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaInicio)
        </dd>
         <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaFinalizacion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaFinalizacion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Diagnostico)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Diagnostico.Descripcion)
        </dd class>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Activo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Activo.Serial)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Solicitudes)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Solicitudes.Descripcion)
        </dd class>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Soportes)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Soportes.Id)
        </dd>
    </dl>
                        </div>
                        <div class="card-footer">
                            <form asp-action="Delete">
                                <input type="hidden" asp-for="Id" />
                                 <input type="submit" value="Borrar" class="btn btn-danger" />
                                 <button type="button" class="btn btn-default"> <a asp-action="Index">Volver</a></button>
                            </form></div>
                    
                         </div>
                     </div>
                 </div>
            </div>
    <div class="col-md-3 "></div>
</div>