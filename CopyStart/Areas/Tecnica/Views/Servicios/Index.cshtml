@model IEnumerable<CopyStart.Entities.Servicio>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>


<table class="table">
    <thead>
        <tr >
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                Tipo de servicio
            </th>
            
            <th>
                @Html.DisplayNameFor(model => model.Activo.Serial)
            </th>
            <th>
               Cliente
            </th>
            
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Diagnostico.TipoServicio.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Activo.Serial)
            </td>
            <td>
                @{
                    var fullName = item.Solicitudes.Cliente.Nombres + " " + item.Solicitudes.Cliente.Apellidos;
                    @Html.DisplayFor(modelItem => fullName)
                }
            </td>
            
            
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
