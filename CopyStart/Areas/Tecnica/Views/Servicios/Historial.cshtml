@model IEnumerable<CopyStart.Entities.Servicio>

@{
    ViewData["Title"] = "Index";
}

<div class="row p-3">
    <div class="col-4">
        
    </div>
    <div class="col-7">
        <form class="form-inline ml-0 ml-md-3">
            <div class="input-group input-group-sm">
                <input class="form-control form-control-navbar" type="search" placeholder="Search" aria-label="Search">
                <div class="input-group-append">
                    <button class="btn btn-navbar" type="submit">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>

</div>

<div class="row ">
    <div class="col-12">
        <div class="card">
            <div class="card-body table-responsive p-0">
                <table class="table  table-hover text-nowrap">
                    <thead class="bg-blue">
                        <tr>
                            <th>
                                 Cliente
                            </th>
                            <th>
                               Tipo de servicio
                            </th>

                            <th>
                              Activo
                            </th>
                            <th>
                               Estado del servicio
                            </th>

                            <th></th>

                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                        <tr>

                            <td>

                                @{
                                    var fullName = item.Solicitudes.Cliente.Nombres + " " + item.Solicitudes.Cliente.Apellidos;
                                    @Html.DisplayFor(modelItem => fullName)
                                }
                               
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TipoServicios.Nombre)
                            </td>
                            <td>
                                  @Html.DisplayFor(modelItem => item.Activo.TipoActivo.Nombre)  ||  @Html.DisplayFor(modelItem => item.Activo.Serial) 
                            </td>
                            <td>
                                  @Html.DisplayFor(modelItem => item.Estado) 

                            </td>

                            <td>
                               <a asp-action="Edit" asp-route-id="@item.Id" role="button" class="btn btn-default bg-blue"><i class="fas fa-pen"></i></a>

                                <a asp-action="Details" asp-route-id="@item.Id" role="button" class="btn btn-default bg-blue"><i class="far fa-file"></i></a>

                                <a asp-action="Delete" asp-route-id="@item.Id" role="button" class="btn btn-default bg-blue"><i class="far fa-trash-alt"></i></a>


                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
