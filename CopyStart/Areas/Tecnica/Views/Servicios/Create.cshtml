@model CopyStart.Entities.Servicio

@{
    ViewData["Title"] = "Crear servicio nuevo";
}



<section class="row">
    <div class="col-md-3 "></div>

    <div class="col-md-6">
        <div class="mt-3">
            <div class="ml-3">
                <div class="card card-primary">
                    <div class="card-header">
                      

                    </div>
                    <div class="card-body">
                        <form asp-action="Create">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <div class="form-group">                               
                                <select asp-for="ActivoId" class="form-control" asp-items="ViewBag.ActivoId" hidden></select>
                            </div>

                            <div class="form-group">
                                <label asp-for="SolicitudId" class="control-label"></label>
                                <select asp-for="SolicitudId" class="form-control" asp-items="ViewBag.SolicitudId"></select>
                            </div>

                             <div class="form-group">
                                <label asp-for="TipoServicioId" class="control-label"></label>
                                <select asp-for="TipoServicioId" class="form-control" asp-items="ViewBag.TipoServicioId"></select>
                            </div>
                            <p>Recuerda iniciar el servicio al estar en la ubicacion</p>
                            <div class="form-group">
                                <input type="submit" value="Create" class="btn btn-primary" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 "></div>
    </div>


</section>










@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }
