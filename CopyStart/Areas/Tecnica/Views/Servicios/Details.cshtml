@model CopyStart.Entities.Servicio

@{
    ViewData["Title"] = "Detalles de servicio";
    var urlProcedimientos = "/Parametricas/TipoServicios/VerProcedimientos?idTipoServicio=" + Model.TipoServicioId;
    var urlSolicitud = "/Tecnica/Solicitudes/Details/" + Model.SolicitudId;

}




<div class="row justify-content-center">
    
    <div class="col-md-6 card">
        <div class="card-header">
             <div class="row mb-3"><b>Información detallada de servicio</b></div>
            <div class="row mb-3">
           
                 <div class="col-md-3 my-2">

                    <a asp-action="Index" role="button" class="btn btn-block btn-default btn-sm">Volver</a>
                </div>



                  <div class="col-md-3 my-2">

                    <a href="@urlSolicitud" role="button" class="btn btn-block btn-default btn-sm">Ver solicitud</a>
                </div>



                @if((Model.Estado=="Por confirmar")&&(User.IsInRole("Tecnico")||User.IsInRole("Coordiandor")))
                {
                    <div class="col-md-3 my-2">
                        <a asp-action="ConfirmarServicio" asp-route-id="@Model.Id" role="button" class="btn btn-block btn-default btn-sm">Iniciar procedimientos</a>

                    </div>
                }
                 @if((Model.Estado=="En ejecucion")&&(User.IsInRole("Tecnico")||User.IsInRole("Coordiandor")))
                {
                    <div class="col-md-3 my-2">
                        <a asp-action="AgregarObservaciones" asp-route-id="@Model.Id" role="button" class="btn btn-block btn-default btn-sm">Agregar observaciones</a>

                    </div>
                }


               
                @if ((Model.Estado!="Por confirmar")&&(User.IsInRole("Tecnico")||User.IsInRole("Coordiandor")))
                {
                <div class="col-md-3 my-2">
                    <a asp-action="EjecucionProcedimientos" asp-route-idServicio="@Model.Id" role="button" class="btn btn-block btn-default btn-sm">Ver procedimientos </a>

                </div>
                }

                 @if ((Model.Estado=="En ejecucion")&&(User.IsInRole("Tecnico")||User.IsInRole("Coordiandor")))
                {
                <div class="col-md-3 my-2">
                    <a asp-action="FinalizarServicio" asp-route-id="@Model.Id" role="button" class="btn btn-block btn-default btn-sm">Finalizar Servicio </a>

                </div>
                }

            </div>
        </div>


        <div class="card-body">
            <dl class="row">

                 <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Activo)
                </dt>
                <dd class="col-sm-8">
                 @Html.DisplayFor(model => model.Activo.TipoActivo.Nombre) @Html.DisplayFor(model => model.Activo.MarcaActivo.Nombre)  @Html.DisplayFor(model => model.Activo.ModeloActivo.Nombre)  S/N:  @Html.DisplayFor(model => model.Activo.Serial)
                </dd>
               
                <dt class="col-sm-4">
                    Cliente
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Activo.Persona.Nombres) @Html.DisplayFor(model => model.Activo.Persona.Apellidos) 
                </dd>
                 <dt class="col-sm-4">
                   Tecnico
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Solicitudes.Tecnico.Nombres) @Html.DisplayFor(model => model.Solicitudes.Tecnico.Apellidos) 
                </dd>
                 <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Solicitudes)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Solicitudes.Incidencia)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Estado)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Estado)
                </dd>
                  @if(Model.Estado!="Por confirmar"){
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.FechaInicio)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.FechaInicio)
                </dd>
                  }
                @if(Model.Estado=="Finalizado"){
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.FechaFinalizacion)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.FechaFinalizacion)
                </dd>
                  <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Observaciones)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Observaciones)
                </dd>
                }

               
            </dl>
        </div>
    </div>
</div>


                               