@model CopyStart.Entities.Servicio

@{
    ViewData["Title"] = "Details";
    var urlDiagnostico = "/Tecnica/Diagnosticos/Details/" + Model.DiagnosticoId;
    var urlProcedimientos = "/Parametricas/TipoServicios/VerProcedimientos?idTipoServicio=" + Model.TipoServicioId;
    var urlSolicitud = "/Tecnica/Solicitudes/Details/" + Model.SolicitudId;

}



<div class="row my-3">
</div>




<div class="row">
    <div class="col-md-3">
    </div>
    <div class="col-md-6 card">
        <div class="card-header">
            <h4 class="col-md-12">Detalles del servicio</h4>
            <div class="row">

                <div class="col-md-3 my-2">

                    <a href="@urlDiagnostico" role="button" class="btn btn-block btn-default btn-sm">Ver Diagnostico</a>
                </div>
                  <div class="col-md-3 my-2">

                    <a href="@urlSolicitud" role="button" class="btn btn-block btn-default btn-sm">Ver Solicitud</a>
                </div>
                @if (User.IsInRole("Cliente") && Model.Estado == "Por confirmar")
                {
                    <div class="col-md-3 my-2">
                        <a asp-action="ConfirmarServicio" asp-route-id="@Model.Id" role="button" class="btn btn-block btn-default btn-sm">Confirmar servicio</a>

                    </div>
                }
                @if ((User.IsInRole("Tecnico") && Model.Estado == "En ejecucion")||(User.IsInRole("Cliente") && Model.Estado == "Por confirmar"))
                {
                <div class="col-md-3 my-2">
                    <a asp-action="FinalizarServicio" asp-route-id="@Model.Id" role="button" class="btn btn-block btn-default btn-sm">Finalizar Servicio </a>

                </div>
                }
                @if (User.IsInRole("Administrador")||User.IsInRole("Coordinador")|| User.IsInRole("Tecnico"))
                {
                <div class="col-md-3 my-2">
                    <a href="@urlProcedimientos" role="button" class="btn btn-block btn-default btn-sm">Ver procedimientos </a>

                </div>
                }

            </div>
        </div>


        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Estado)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Estado)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.FechaRealizacion)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.FechaRealizacion)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Diagnostico)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Diagnostico.Descripción)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Activo)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Activo.Serial)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Solicitudes)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Solicitudes.Descripcion)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Soportes)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Soportes.Id)
                </dd>
            </dl>
        </div>
    </div>
    <div class="col-md-3"></div>
</div>
