@model CopyStart.Entities.Servicio

@{
    ViewData["Title"] = "Details";
    var urlDiagnostico = "/Tecnica/Diagnosticos/Details/" + Model.DiagnosticoId;
    var urlProcedimientos = "/Parametricas/TipoServicios/VerProcedimientos?idTipoServicio=" + Model.TipoServicioId;
}



<div class="row my-3">

</div>




<div class="row">
    <div class="col-md-3">
    </div>
    <div class="col-md-6 card">
        <div class="card-header row">
            <h4 class="col-md-8">Detalles del servicio</h4>

            <div class="col-md-4">
                <div class="mb-3">
                    <button type="button" class="btn btn-block btn-default btn-sm"><a href="@urlDiagnostico">Ver Diagnostico </a> </button>
                    <button type="button" class="btn btn-block btn-default btn-sm"><a href="#">Confirmar Servicio </a> </button>
                    <button type="button" class="btn btn-block btn-default btn-sm"><a href="@urlProcedimientos">Ver procedimientos </a> </button>


                </div>
            </div>
        </div>


        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Estado)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Estado)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.FechaRealizacion)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.FechaRealizacion)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Diagnostico)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Diagnostico.Descripción)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Activo)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Activo.Marca)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Solicitudes)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Solicitudes.Descripcion)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Soportes)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Soportes.Id)
                </dd>
            </dl>
        </div>
    </div>
    <div class="col-md-3"></div>
</div>
