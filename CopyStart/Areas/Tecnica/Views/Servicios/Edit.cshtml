@model CopyStart.Entities.Servicio

@{
    ViewData["Title"] = "Editar";
}


<div class="row justify-content-center">

    <div class="col-md-6">
        <div class="mt-3">
            
                <div class="card card-primary">
                    
                    <div class="card-body">
                        <div class="row">
                         <form asp-action="Edit">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <input type="hidden" asp-for="Id" />
                                               
                            <div class="form-group col-md-6">
                                <label asp-for="ActivoId" class="control-label"></label>
                                <select asp-for="ActivoId" class="form-control select2" asp-items="ViewBag.ActivoId">
                                    <option></option>
                                </select>
                                <span asp-validation-for="ActivoId" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="SolicitudId" class="control-label"></label>
                                <select asp-for="SolicitudId" class="form-control select2" asp-items="ViewBag.SolicitudId">
                                    <option></option>
                                </select>
                                <span asp-validation-for="SolicitudId" class="text-danger"></span>
                            </div>
                            
                            <div class="form-group col-md-12">
                                <input type="submit" value="Guardar" class="btn btn-primary float-left" />
                            </div>
                        </form>
                    </div>
                    </div>
                </div>
            
        </div>

    </div>

</div>

@section Scripts {
    @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
}