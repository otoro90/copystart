                    <input class="form-check-input" asp-for="ProcedimientosRealizados" /> @Html.DisplayNameFor(model => model.ProcedimientosRealizados)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="Observaciones" class="control-label"></label>
                <input asp-for="Observaciones" class="form-control" />
