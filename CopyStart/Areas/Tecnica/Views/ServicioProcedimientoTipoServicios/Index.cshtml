@model IEnumerable<CopyStart.Entities.ServicioProcedimientoTipoServicio>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table  class="table table-bordered table-hover" id="table-spts">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Servicio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProcedimientoTipoServicio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProcedimientosRealizados)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Observaciones)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Servicio.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProcedimientoTipoServicio.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProcedimientosRealizados)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Observaciones)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
