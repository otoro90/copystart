@model CopyStart.Entities.Solicitud

@{
    ViewData["Title"] = "Crear solicitud de servicio";
}


<section class="row justify-content-center">


    <div class="col-md-12">
        <div class="mt-3">
           
                <div class="card card-primary">
                   <div class="card-header">
                       Formulario de creación de solicitud
                   </div>
                    <div class="card-body">
                        <form asp-action="Create">
                            <div class="row">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                             <div class="form-group col-md-6">
                                 <label asp-for="ActivoId" class="control-label"></label>
                                 <select asp-for="ActivoId" class ="form-control select2" asp-items="ViewBag.ActivoId"></select>
                              </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Incidencia" class="control-label"></label>
                                <input asp-for="Incidencia" class="form-control" />
                                <span asp-validation-for="Incidencia" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-12">
                                <label asp-for="Descripcion" class="control-label"></label>
                                @Html.TextAreaFor(modelItem => modelItem.Descripcion, new { style = "width: 100%; height: 60px ", @class = "form-control" })
                                <span asp-validation-for="Descripcion" class="text-danger"></span>
                            </div>

                                <div class="form-group">
                                <select asp-for="ClienteId" class="form-control" asp-items="ViewBag.ClienteId" hidden></select>
                            </div>  

                            <div class="form-group">
                                <input type="submit" value="Crear" class="btn btn-primary" />

                            </div>
                            </div>
                        </form>
                    </div>
                </div>
           
        </div>

    </div>


</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
