@model CopyStart.Entities.Solicitud

@{
    ViewData["Title"] = "Create";
}



<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}



<div class="row">
    <div class="col-md-3 "></div>

    <div class="col-md-6">
        <div class="mt-3">
            <div class="ml-3">
                <div class="card card-primary">
                    <div class="card-header">
                        <h2 class="card-title"><b>Crear solicitud</b></h2>

                    </div>
                    <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group">
                            <label asp-for="Incidencia" class="control-label"></label>
                            <input asp-for="Incidencia" class="form-control" />
                            <span asp-validation-for="Incidencia" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Descripcion" class="control-label"></label>
                            <input asp-for="Descripcion" class="form-control" />
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Ubicacion" class="control-label"></label>
                            <input asp-for="Ubicacion" class="form-control" />
                            <span asp-validation-for="Ubicacion" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="FechaSolicitud" class="control-label"></label>
                            <input asp-for="FechaSolicitud" class="form-control" />
                            <span asp-validation-for="FechaSolicitud" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="EstadoSolicitud" class="control-label"></label>
                            <input asp-for="EstadoSolicitud" class="form-control" />
                            <span asp-validation-for="EstadoSolicitud" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="TecnicoId" class="control-label"></label>
                            <select asp-for="TecnicoId" class="form-control" asp-items="ViewBag.TecnicoId"></select>
                        </div>
                        <div class="form-group">
                            <label asp-for="ClienteId" class="control-label"></label>
                            <select asp-for="ClienteId" class="form-control" asp-items="ViewBag.ClienteId"></select>
                        </div>
                        <div class="form-group">
                            <label asp-for="ActivoId" class="control-label"></label>
                            <select asp-for="ActivoId" class="form-control" asp-items="ViewBag.ActivoId"></select>
                        </div>
                        <div class="form-group">
                            <input type="submit" value="Create" class="btn btn-primary" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 "></div>
</div>
</div>