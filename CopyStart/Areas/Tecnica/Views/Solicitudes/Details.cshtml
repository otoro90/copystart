@model CopyStart.Entities.Solicitud

@{
    ViewData["Title"] = "Detalles de solicitud";
    var urlDiagnostico = "/Tecnica/Diagnosticos/Create?idSolicitud=" + Model.Id;
}

<div class="row my-3">
</div>




<div class="row">
    <div class="col-md-3">
    </div>
    <div class="col-md-6 card">

        <div class="card-header">
           

            <div class="row">
                 @if (User.IsInRole("Cliente"))
                {
                    <div class="col-md-3 my-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" role="button" class="btn btn-block btn-default btn-sm">Editar </a>
                    </div>
                }
                <div class="col-md-3 my-2">
                    <a asp-action="Index" role="button" class="btn btn-block btn-default btn-sm">Volver </a>
                </div>
                @if (User.IsInRole("Coordinador") && Model.EstadoSolicitud == "Por tramitar")
                {
                    <div class="col-md-3 my-2">
                        <a asp-action="TramitarSolicitud" asp-route-id="@Model.Id" role="button" class="btn btn-block btn-default btn-sm"> Tramitar</a>
                    </div>
                }
                @if (User.IsInRole("Tecnico") && Model.EstadoSolicitud == "Por diagnosticar")
                {
                    <div class="col-md-3 my-2">
                        <a href="@urlDiagnostico" role="button" class="btn btn-block btn-default btn-sm">Realizar diagnostico </a>
                    </div>
                }

                @if  (Model.EstadoSolicitud == "Diagnosticada") 
                {
                <div class="col-md-3 my-2">
                    <a asp-action="VerServicio" asp-route-id="@Model.Id" role="button" class="btn btn-block btn-default btn-sm">Ver servicio </a>
                </div>
                }
            </div>

        </div>


        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Incidencia)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Incidencia)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Descripcion)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Descripcion)
                </dd> 
                 
                 <dt class="col-sm-4">
                    Ciudad
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Activo.Ubicacion.Lugar) 
                </dd>
                <dt class="col-sm-4">
                    Direccion
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Activo.Direccion) 
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.FechaSolicitud)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.FechaSolicitud)
                </dd>

                @if(Model.EstadoSolicitud=="Por diagnosticar"){
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.FechaAsignacion)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.FechaAsignacion)
                </dd>


                }

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.EstadoSolicitud)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.EstadoSolicitud)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Tecnico)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Tecnico.Nombres) @Html.DisplayFor(model => model.Tecnico.Apellidos)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Cliente)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Cliente.Nombres) @Html.DisplayFor(model => model.Cliente.Apellidos)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Activo)
                </dt>
                <dd class="col-sm-8">
                   @Html.DisplayFor(model => model.Activo.MarcaActivo.Nombre) @Html.DisplayFor(model => model.Activo.ModeloActivo.Nombre)   S/N: @Html.DisplayFor(model => model.Activo.Serial)
                </dd>

            @if(Model.EstadoSolicitud=="Cancelada"){
                <dt class="col-sm-4">
                    Motivo de cancelacion
                </dt>
                <dd class="col-sm-8">
                   @Html.DisplayFor(model => model.Motivo)
                </dd>

            }
            </dl>
        </div>
    </div>
    <div class="col-md-3"></div>
</div>


