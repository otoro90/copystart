@model CopyStart.Areas.Tecnica.Models.SolicitudRapidaModel

@{
    ViewData["Title"] = "Crear solicitud rapida";
}


<section class="row">
    <div class="col-md-3 "></div>

    <div class="col-md-6">
        <div class="mt-3">
            <div class="ml-3">
                <div class="card card-primary">

                    <div class="card-body">
                        <form asp-action="Create">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <div class="row">
                                <div class="form-group col-md-5">
                                    <label asp-for="TipoDocumentoId" class="control-label"></label>
                                    <select asp-for="TipoDocumentoId" class="form-control" asp-items="ViewBag.TipoDocumentoId"></select>

                                </div>
                                <div class="form-group col-md-7">
                                    <label asp-for="NumeroDocumento" class="control-label"></label>
                                    <input asp-for="NumeroDocumento" class="form-control" />

                                </div>

                            
                            <div class="form-group col-md-6">
                                    <label asp-for="TipoActivoId" class="control-label"></label>
                                    <select asp-for="TipoActivoId" class="form-control" asp-items="ViewBag.TipoActivoId"></select>

                            </div>

                             <div class="form-group col-md-6">
                                    <label asp-for="MarcaActivoId" class="control-label"></label>
                                    <select asp-for="MarcaActivoId" class="form-control" asp-items="ViewBag.MarcaActivoId"></select>

                            </div>
                             <div class="form-group col-md-6">
                                    <label asp-for="ModeloActivoId" class="control-label"></label>
                                    <select asp-for="ModeloActivoId" class="form-control" asp-items="ViewBag.ModeloActivoId"></select>

                            </div>

                            <div class="form-group col-md-6">
                                <label asp-for="Serial" class="control-label"></label>
                                <input asp-for="Serial" class="form-control" />
                                <span asp-validation-for="Serial" class="text-danger"></span>
                            </div>
                           

                            
                             <div class="form-group col-md-6">
                                    <label asp-for="UbicacionId" class="control-label"></label>
                                    <select asp-for="UbicacionId" class="form-control" asp-items="ViewBag.UbicacionId"></select>

                            </div>

                            <div class="form-group col-md-6">
                                <label asp-for="Direccion" class="control-label"></label>
                                <input asp-for="Direccion" class="form-control" />
                                <span asp-validation-for="Direccion" class="text-danger"></span>
                            </div>


                            <div class="form-group col-md-12">
                                <label asp-for="Incidencia" class="control-label"></label>
                                <input asp-for="Incidencia" class="form-control" />
                                <span asp-validation-for="Incidencia" class="text-danger"></span>
                            </div>
                            
                            </div>
                           
                            <div class="form-group">
                                <input type="submit" value="Crear" class="btn btn-primary" />

                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 "></div>
    </div>


</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }
