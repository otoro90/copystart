@model CopyStart.Areas.Tecnica.Models.SolicitudRapidaModel

@{
    ViewData["Title"] = "Crear solicitud rapida";
}

<section class="row">
    <div class="col-md-12">
        <div class="card card-primary">

            <div class="card-body">
                <form asp-action="CrearSolicitudRapida" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="row">
                        <div id="datos-persona" class="@((@Model?.Persona?.NumeroDocumento == null) ? "col-12" :"d-none" )">
                            <div class="form-group">
                                <label asp-for="Persona.TipoDocumentoId" class="control-label"></label>
                                <select asp-for="Persona.TipoDocumentoId" class="form-control select2" asp-items="ViewBag.TipoDocumentoId">
                                    <option></option>
                                </select>

                            </div>
                            <div class="form-group">
                                <label asp-for="Persona.NumeroDocumento" class="control-label"></label>
                                <input asp-for="Persona.NumeroDocumento" class="form-control" />
                            </div>
                        </div>

                        <div id="form-persona" class="@(((@Model?.Persona?.NumeroDocumento != null)&&(@Model?.Persona?.Nombres==null)) ? "col-12" : "d-none")">

                            <div class="form-group col-md-8">
                                <label asp-for="Persona.Nombres" class="control-label"></label>
                                <input asp-for="Persona.Nombres" class="form-control" />
                                <span asp-validation-for="Persona.Nombres" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-8">
                                <label asp-for="Persona.Apellidos" class="control-label"></label>
                                <input asp-for="Persona.Apellidos" class="form-control" />
                                <span asp-validation-for="Persona.Apellidos" class="text-danger"></span>
                            </div>

                            <div class="form-group col-md-8">
                                <label asp-for="Persona.Telefono" class="control-label"></label>
                                <input asp-for="Persona.Telefono" class="form-control" />
                                <span asp-validation-for="Persona.Telefono" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-8">
                                <label>Ubicacion</label>
                                <select asp-for="Persona.UbicacionId" class="form-control" asp-items="ViewBag.UbicacionId"></select>
                                <span asp-validation-for="Persona.UbicacionId" class="text-danger"></span>
                            </div>

                        </div>

                        <div id="datos-activo" class="@(((@Model?.Activo?.Serial == null)&&(@Model?.Persona?.Nombres != null)) ?  "col-12" : "d-none")">

                            <div class="form-group col-md-6">
                                <label asp-for="Activo.Serial" class="control-label"></label>
                                <input asp-for="Activo.Serial" class="form-control" />
                                <span asp-validation-for="Activo.Serial" class="text-danger"></span>
                            </div>

                        </div>

                        <div id="form-activo" class="@(((@Model?.Activo?.Serial != null)&&(@Model?.Activo?.Direccion == null)) ?  "col-12" : "d-none")">
                            <div class="form-group col-md-6">
                                <label asp-for="Activo.TipoActivoId" class="control-label"></label>
                                <select asp-for="Activo.TipoActivoId" class="form-control" asp-items="ViewBag.TipoActivoId">
                                </select>
                            </div>

                            <div class="form-group col-md-6">
                                <label asp-for="Activo.MarcaActivoId" class="control-label"></label>
                                <select asp-for="Activo.MarcaActivoId" class="form-control" asp-items="ViewBag.MarcaActivoId"></select>

                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Activo.ModeloActivoId" class="control-label"></label>
                                <select asp-for="Activo.ModeloActivoId" class="form-control" asp-items="ViewBag.ModeloActivoId"> </select>

                            </div>

                            <div class="form-group col-md-6">
                                <label asp-for="Activo.UbicacionId" class="control-label"></label>
                                <select asp-for="Activo.UbicacionId" class="form-control" asp-items="ViewBag.UbicacionId"> </select>

                            </div>

                            <div class="form-group col-md-6">
                                <label asp-for="Activo.Direccion" class="control-label"></label>
                                <input asp-for="Activo.Direccion" class="form-control" />
                                <span asp-validation-for="Activo.Direccion" class="text-danger"></span>
                            </div>

                        </div>
                        <div id="datos-solicitud" class="@(((@Model?.Activo?.Direccion != null)&&(@Model?.Solicitud?.Incidencia == null)) ? "col-12" : "d-none")">

                            <div class="form-group col-md-12">
                                <label asp-for="Solicitud.Incidencia" class="control-label"></label>
                                <input asp-for="Solicitud.Incidencia" class="form-control" />
                                <span asp-validation-for="Solicitud.Incidencia" class="text-danger"></span>
                            </div>


                        </div>

                        <div class="form-group col-md-12">
                            <input type="submit" value="@(@Model?.Activo == null ? "Validar" : "Crear")" class="btn btn-primary" />
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>


</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
