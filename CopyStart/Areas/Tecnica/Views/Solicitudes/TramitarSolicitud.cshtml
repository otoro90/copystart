@model CopyStart.Entities.Solicitud
@{
    ViewData["Title"] = "Tramitar solicitud";
}


    <div class="row">
        <div class="col-md-3 "></div>

        <div class="col-md-6">
            <div class="mt-3">
                <div class="ml-3">
                    <div class="card card-secondary">
                        <div class="card-header">
                            ¿Que quieres hacer con esta solicitud?
                        </div>


                        <div class="card-body row">
                            <div class="mb-3 col-12">
                                <a asp-action="AsignarTecnico" asp-route-id="@Model.Id" role="button" class="btn btn-block btn-default btn-lg">Asignar Tecnico </a> 
                            </div>
                            <div class="mb-3 col-12">
                               <a asp-action="CancelarSolicitud" asp-route-id="@Model.Id" role="button" class="btn btn-block btn-default btn-lg">Cancelar solicitud </a> 
                            </div>
                            <div class="mb-3 col-12">
                                <a asp-action="Details" asp-route-id="@Model.Id" role="button" class="btn btn-block btn-default btn-lg"> Volver </a> 
                            </div>

                            

                        </div>

                       
                    </div>

                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 "></div>


    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    }
