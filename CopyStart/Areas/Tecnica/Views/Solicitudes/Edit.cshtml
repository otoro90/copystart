@model CopyStart.Entities.Solicitud

@{
    ViewData["Title"] = "Editar solicitud";
}



<div class="row">
    <div class="col-md-3 "></div>
    <div class="col-md-6">
        <div class="mt-3">
            <div class="ml-3">
                <div class="card card-primary">
                    
                    <div class="card-body">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <div class="form-group">
                            <label asp-for="Incidencia" class="control-label"></label>
                            <input asp-for="Incidencia" class="form-control" />
                            <span asp-validation-for="Incidencia" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Descripcion" class="control-label"></label>
                            <input asp-for="Descripcion" class="form-control" />
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>
                       
                            <input type="hidden" asp-for="FechaSolicitud" class="form-control" />
                              
                            <input asp-for="EstadoSolicitud" type="hidden" class="form-control" />                
                            
                            <input asp-for="TecnicoId" class="form-control" type="hidden" class="form-control">
                   
                            <input asp-for="ClienteId" class="form-control" type="hidden">

                            <input asp-for="ActivoId" class="form-control" type="hidden">
                            
                        
                        <div class="form-group">
                            <input type="submit" value="Guardar" class="btn btn-primary" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 "></div>
</div>

</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
