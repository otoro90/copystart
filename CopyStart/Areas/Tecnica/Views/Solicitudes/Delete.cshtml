@model CopyStart.Entities.Solicitud

@{
    ViewData["Title"] = "Borrar solicitud";
}


<div class="row justify-content-center">


    <div class="col-md-12">
        <div class="mt-3">
            
                <div class="card card-primary">
                    <div class="card-header bg-red">
                       ¿Quieres cancelar esta solicitud?
                    </div>


                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-4">
                                @Html.DisplayNameFor(model => model.Incidencia)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.Incidencia)
                            </dd>
                            <dt class="col-sm-4">
                                @Html.DisplayNameFor(model => model.Descripcion)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.Descripcion)
                            </dd>
                         
                            <dt class="col-sm-4">
                                @Html.DisplayNameFor(model => model.FechaSolicitud)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.FechaSolicitud)
                            </dd>
                            <dt class="col-sm-4">
                                @Html.DisplayNameFor(model => model.EstadoSolicitud)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.EstadoSolicitud)
                            </dd>
                            <dt class="col-sm-4">
                                @Html.DisplayNameFor(model => model.Tecnico)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.Tecnico.Id)
                            </dd>
                            <dt class="col-sm-4">
                                @Html.DisplayNameFor(model => model.Cliente)
                            </dt>
                            <dd class="col-sm-8">
                                @Html.DisplayFor(model => model.Cliente.Id)
                            </dd>
                            <dt class="col-sm-4">
                                @Html.DisplayNameFor(model => model.Activo)
                            </dt>
                            <dd class="col-sm-8">
                                 @Html.DisplayFor(model => model.Activo.MarcaActivo.Nombre) @Html.DisplayFor(model => model.Activo.ModeloActivo.Nombre)   S/N: @Html.DisplayFor(model => model.Activo.Serial)
                            </dd>
                        </dl>
                    </div>
                    <div class="card-footer">
                        <form asp-action="Delete">
                            <input type="hidden" asp-for="Id" />
                            <input type="submit" value="Borrar" class="btn btn-danger" />
                            <button type="button" class="btn btn-default"> <a asp-action="Index">Volver</a></button>
                        </form>
                    </div>

                </div>
            
        </div>
    </div>

</div>