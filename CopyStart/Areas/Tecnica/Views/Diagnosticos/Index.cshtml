@model IEnumerable<CopyStart.Entities.Diagnostico>

@{
    ViewData["Title"] = "Index";
}


<div class="row ">
    <div class="col-12">
        <div class="card">
          

            <div class="card-body table-responsive p-0">

                <table class="table  table-hover text-nowrap">

                    <thead class="bg-blue">
                        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Descripción)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaDiagnostico)
            </th>
            
            
            <th></th>
        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                        <tr>
                            <td>
                @Html.DisplayFor(modelItem => item.Descripción)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaDiagnostico)
            </td>
            
           

                            <td>
                               <a asp-action="Edit" asp-route-id="@item.Id" role="button" class="btn btn-default bg-blue"><i class="fas fa-pen"></i></a>

                                <a asp-action="Details" asp-route-id="@item.Id" role="button" class="btn btn-default bg-blue"><i class="far fa-file"></i></a>

                                <a asp-action="Delete" asp-route-id="@item.Id" role="button" class="btn btn-default bg-blue"><i class="far fa-trash-alt"></i></a>


                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
