@model CopyStart.Entities.Diagnostico

@{
    ViewData["Title"] = "Detalles de diagnostico";
    var urlServicio = "/Tecnica/Servicios/Details?idDiagnostico=" + Model.Id;
}


<div class="row my-3">
</div>


<div class="row">
    <div class="col-md-3">
    </div>
    <div class="col-md-6 card">
        <div class="card-header">
            
            <div class="row">

                <div class="col-md-3 my-2">
                      <a role="button" class="btn btn-block btn-default btn-sm" asp-action="Edit" asp-route-id="@Model.Id">Editar</a> 
                </div>
                  <div class="col-md-3 my-2">

                    <a href="@urlServicio" role="button" class="btn btn-block btn-default btn-sm">Ver Servicio</a>
                </div>
                <div class="col-md-3 my-2">
                    <a role="button" class="btn btn-block btn-default btn-sm" asp-action="Index">Volver</a> 
                </div>

            </div>
        </div>


        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Descripción)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Descripción)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.FechaDiagnostico)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.FechaDiagnostico)
                </dd>

                
            </dl>
        </div>
    </div>
    <div class="col-md-3"></div>
</div>
