@model CopyStart.Entities.Diagnostico

@{
    ViewData["Title"] = "Details";
}


<div class="row my-3">
</div>


<div class="row">
    <div class="col-md-3">
    </div>
    <div class="col-md-6 card">
        <div class="card-header">
            <h4 class="col-md-12">Detalles del diagnostico</h4>
            <div class="row">

                <div class="col-md-3 my-2">
                    <button type="button" class="btn btn-block btn-default btn-sm">  <a asp-action="Edit" asp-route-id="@Model.Id">Editar</a>  </button>
                </div>
                <div class="col-md-3 my-2">
                    <button type="button" class="btn btn-block btn-default btn-sm"><a asp-action="Index">Volver</a> </button>
                </div>

            </div>
        </div>


        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Descripción)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Descripción)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.FechaDiagnostico)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.FechaDiagnostico)
                </dd>

                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Soportes)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Soportes.Id)
                </dd>
            </dl>
        </div>
    </div>
    <div class="col-md-3"></div>
</div>
