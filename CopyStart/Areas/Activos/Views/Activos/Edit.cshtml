@model CopyStart.Entities.Activo

@{
    ViewData["Title"] = "Editar activo";
}


<div class="row justify-content-center">

    <div class="col-md-12">
        <div class="mt-3">
            <div class="card card-primary">
                <div class="card-header">
                    Formulario de edición de activos
                </div>
                <div class="card-body">
                    @Html.HiddenFor(m => m.UbicacionId)
                    <form asp-action="Edit">
                        <div class="row">

                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <input type="hidden" asp-for="Id" />

                            <div class="form-group col-md-6">
                                <label asp-for="TipoActivoId" class="control-label"></label>
                                <select asp-for="TipoActivoId" class="form-control" asp-items="ViewBag.TipoActivoId" disabled></select>
                                <span asp-validation-for="TipoActivoId" class="text-danger"></span>
                            </div>

                            <div class="form-group col-md-6">
                                <label asp-for="Serial" class="control-label"></label>
                                <input type="text" asp-for="Serial" class="form-control" readonly />
                                <span asp-validation-for="Serial" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="MarcaActivoId" class="control-label"></label>
                                <select asp-for="MarcaActivoId" class="form-control select2" asp-items="ViewBag.MarcaActivoId">
                                    <option></option>
                                </select>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="ModeloActivoId" class="control-label"></label>
                                <select asp-for="ModeloActivoId" class="form-control select2" asp-items="ViewBag.ModeloActivoId">
                                    <option></option>
                                </select>
                            </div>

                            <div class="form-group col-md-6">
                                <label asp-for="Descripcion" class="control-label"></label>
                                <input asp-for="Descripcion" class="form-control" />
                                <span asp-validation-for="Descripcion" class="text-danger"></span>
                            </div>



                            <div class="form-group col-md-3">

                                <label asp-for="Ubicacion.CodigoDepartamento" class="control-label">Departamento</label>
                                <select asp-for="Ubicacion.CodigoDepartamento" class="form-control select2">
                                    <option></option>
                                </select>
                                <span asp-validation-for="Ubicacion.CodigoDepartamento" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-3">
                                <label asp-for="UbicacionId" class="control-label">Municipio</label>
                                <select asp-for="UbicacionId" class="form-control select2">
                                    <option></option>
                                </select>
                                <span asp-validation-for="UbicacionId" class="text-danger"></span>
                            </div>

                            <div class="form-group col-md-6">
                                <label asp-for="Direccion" class="control-label"></label>
                                <input asp-for="Direccion" class="form-control" />
                                <span asp-validation-for="Direccion" class="text-danger"></span>
                            </div>

                            <div class="form-group">

                                <input asp-for="FechaRegistro" class="form-control" hidden />

                            </div>
                            <div class="form-group">

                                <select asp-for="PersonaId" class="form-control" asp-items="ViewBag.PersonaId" hidden></select>

                            </div>
                            <div class="form-group">
                                <input class="form-control" asp-for="Estado" hidden />
                            </div>
                            <div class="form-group col-md-12">
                                <input type="submit" value="Guardar" class="btn btn-primary float-right" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>





@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }
