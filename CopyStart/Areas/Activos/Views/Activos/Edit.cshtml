@model CopyStart.Entities.Activo

@{
    ViewData["Title"] = "Editar activo";
}


<div class="row">
    <div class="col-md-3 "></div>
    <div class="col-md-6">
        <div class="mt-3">
            <div class="ml-3">
                <div class="card card-primary">
                   

                    <form asp-action="Edit">
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <input type="hidden" asp-for="Id" />
                           
                            <div class="form-group">
                                <label asp-for="Serial" class="control-label"></label>
                                <input type="text" asp-for="Serial" class="form-control" readonly />
                                <span asp-validation-for="Serial" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="TipoActivoId" class="control-label">@Html.DisplayNameFor(model => model.TipoActivo)</label>
                                <select asp-for="TipoActivoId" class="form-control" asp-items="ViewBag.TipoActivoId" readonly></select>
                                <span asp-validation-for="TipoActivoId" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Descripcion" class="control-label"></label>
                                <input asp-for="Descripcion" class="form-control" />
                                <span asp-validation-for="Descripcion" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label class="control-label">Marca de activo</label>
                                <select asp-for="MarcaActivoId" class="form-control" asp-items="ViewBag.MarcaActivoId"></select>
                            </div>
                            <div class="form-group">
                                <label class="control-label">Modelo de activo</label>
                                <select asp-for="ModeloActivoId" class="form-control" asp-items="ViewBag.ModeloActivoId"></select>
                            </div>

                              <div class="form-group">
                            <label asp-for="UbicacionId" class="control-label"></label>
                            <select asp-for="UbicacionId" class="form-control"asp-items="ViewBag.UbicacionId"></select>
                            <span asp-validation-for="UbicacionId" class="text-danger"></span>
                        </div>

                          <div class="form-group">
                            <label asp-for="Direccion" class="control-label"></label>
                            <input asp-for="Direccion" class="form-control" />
                            <span asp-validation-for="Direccion" class="text-danger"></span>
                        </div>
                            
                            <div class="form-group">

                                <input asp-for="FechaRegistro" class="form-control" hidden />

                            </div>
                            <div class="form-group">

                                <select asp-for="PersonaId" class="form-control" asp-items="ViewBag.PersonaId" hidden></select>

                            </div>
                            <div class="form-group">
                               <input class="form-control" asp-for="Estado" hidden/>
                            </div>
                            <div class="form-group">
                                <input type="submit" value="Guardar" class="btn btn-primary" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 "></div>
</div>


       
   

    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    }
