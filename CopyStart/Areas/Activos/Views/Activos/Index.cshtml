@model IEnumerable<CopyStart.Entities.Activo>

@{
    ViewData["Title"] = "Index";
}

<div class="row p-3">
    
   
</div>

<div class="row ">
    <div class="col-12">
        <div class="card">
            <div class="card-body table-responsive p-0">
                <table class="table  table-hover text-nowrap" id="table-activos">
                    <thead class="bg-blue">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.Serial)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.TipoActivo)
                            </th>

                            <th>
                                Marca
                            </th>
                            <th>
                                Modelo
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Estado)
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Serial)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.TipoActivo.Nombre)
                                </td>

                                <td>
                                    @Html.DisplayFor(modelItem => item.MarcaActivo.Nombre)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ModeloActivo.Nombre)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Estado)
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id" role="button" class="btn btn-default bg-blue"><i class="fas fa-pen"></i></a>

                                <a asp-action="Details" asp-route-id="@item.Id" role="button" class="btn btn-default bg-blue"><i class="far fa-file"></i></a>

                                      <a asp-action="Eliminar" asp-route-id="@item.Id" role="button" class="btn btn-default bg-blue"><i class="far fa-trash-alt"></i></a>

                                   

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>