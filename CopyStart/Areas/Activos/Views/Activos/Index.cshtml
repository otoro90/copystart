@model IEnumerable<CopyStart.Entities.Activo>

@{
    ViewData["Title"] = "Index";
}




   
<div class="row p-3">
    <div class="col-4"
    <a asp-action="Create">
        <button type="button" class="btn btn-default bg-blue">
           <i class="fas fa-plus mr-3"></i>
       </button>
    </a>
   </div>
    <div class="col-7">
        <form class="form-inline ml-0 ml-md-3">
            <div class="input-group input-group-sm">
                <input class="form-control form-control-navbar" type="search" placeholder="Search" aria-label="Search">
                <div class="input-group-append">
                    <button class="btn btn-navbar" type="submit">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>

</div>



<div class="row ">
    <div class="col-12">
        <div class="card">
          

            <div class="card-body table-responsive p-0">

                <table class="table  table-hover text-nowrap">

                    <thead class="bg-blue">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.Serial)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.TipoActivo)
                            </th>
                           
                            <th>
                                @Html.DisplayNameFor(model => model.Marca)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Modelo)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Estado)
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Serial)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TipoActivo.Codigo)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.Marca)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Modelo)
                            </td>
                            
                           

                            <td>
                                @Html.DisplayFor(modelItem => item.Estado)
                            </td>

                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id">
                                    <button type="button" class="btn btn-default bg-blue">
                                        <i class="far fa-file"></i>
                                    </button>
                                </a>

                                <a asp-action="Edit" asp-route-id="@item.Id">
                                    <button type="button" class="btn btn-default bg-blue">


                                        <i class="fas fa-pen"></i>
                                    </button>
                                </a>




                                <a asp-action="Delete" asp-route-id="@item.Id">
                                    <button type="button" class="btn btn-default bg-blue">
                                        <i class="far fa-trash-alt"></i>
                                    </button>
                                </a>


                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
