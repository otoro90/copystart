@model CopyStart.Entities.Activo

@{
    ViewData["Title"] = "Details";
    var urlSolicitudes = "/Tecnica/Solicitudes/Create?idActivo="+Model.Id;
    var urlServiciosActivo = "/Tecnica/Servicios/HistorialPorActivo?idActivo=" + Model.Id;
}


   <div class="row ml-3">
        <a asp-action="Index"> 
            <button  type="button" class="btn btn-default bg-blue">
           <i class="fas fa-angle-left"></i>
            
            
            </button>
            <p> Volver</p>
            </a>
   </div>  

<div class="row">
    <div class="col-md-3">
    </div>
    <div class="col-md-6 card">
        <div class="card-header row">
            <h4 class="col-md-6">Detalles del activo</h4>

            <div class="col md-6">
                <div class="col-md-12 my-1">
                    <button type="button" class="btn btn-block btn-default btn-sm"><a asp-action="Edit" asp-route-id="@Model.Id">Editar </a> </button>
                </div>
                <div class="col-md-12 my-1">
                    <button type="button" class="btn btn-block btn-default btn-sm"><a asp-action="Index">Volver </a> </button>
                </div>
                <div class="col-md-12 my-1">
                    <button type="button" class="btn btn-block btn-default btn-sm"><a href="@urlSolicitudes">Solicitar</a></button>
                </div>
                <div class="col-md-12 my-1">
                    <button type="button" class="btn btn-block btn-default btn-sm"><a href="@urlServiciosActivo">Historial </a></button>
                </div>
            </div>


        </div>
         
    
    <div class="card-body">
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Serial)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Serial)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TipoActivo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TipoActivo.Nombre)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Descripcion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Descripcion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MarcaActivo.Nombre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MarcaActivo.Nombre)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ModeloActivo.Nombre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ModeloActivo.Nombre)
        </dd>
        
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaRegistro)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaRegistro)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Persona)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Persona.Nombres) @Html.DisplayFor(model => model.Persona.Apellidos)
        </dd>
    </dl>
    </div>
    </div>
    <div class="col-md-3"></div>
</div>



