@model CopyStart.Entities.Activo

@{
    ViewData["Title"] = "Details";
}


   <div class="row ml-3">
        <a asp-action="Index"> 
            <button  type="button" class="btn btn-default bg-blue">
           <i class="fas fa-angle-left"></i>
            
            
            </button>
            <p> Volver</p>
            </a>
   </div>  

<div class="row">
    <div class="col-md-3">
    </div>
    <div class="col-md-6 card">
        <div class="card-header row">
            <h4 class="col-md-6">Detalles del activo</h4>


            <div class="col-md-2 my-1">
                <button type="button" class="btn btn-block btn-default btn-sm"><a asp-action="Edit" asp-route-id="@Model.Id">Editar </a> </button>
            </div>
            <div class="col-md-2 my-1" >
                <button type="button" class="btn btn-block btn-default btn-sm"><a asp-action="Index">Volver </a> </button>
            </div>
            <div class="col-md-2 my-1">
                <button type="button" class="btn btn-block btn-default btn-sm" ><a href="/Tecnica/Solicitudes/Create">Solicitar</a></button>
            </div>

        </div>
         
    
    <div class="card-body">
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Serial)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Serial)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TipoActivo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TipoActivo.Codigo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Descripcion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Descripcion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Marca)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Marca)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Modelo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Modelo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Ubicacion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Ubicacion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaRegistro)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaRegistro)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Persona)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Persona.Id)
        </dd>
    </dl>
    </div>
    </div>
    <div class="col-md-3"></div>
</div>



