@model CopyStart.Entities.Activo

@{
  
    ViewData["Title"] = "Detalles de activo";
    var urlSolicitudes = "/Tecnica/Solicitudes/Create?idActivo=" + Model.Id;
    var urlServiciosActivo = "/Tecnica/Servicios/HistorialPorActivo?idActivo=" + Model.Id;
}



<div class="row justify-content-center">
   
    <div class="col-md-6 card">
        <div class="card-header">
            <div class="row mb-3">
                <b>Información detallada de activo</b>
            </div>

            <div class="row">

                 <div class="col-md-3 my-2">
                    <a asp-action="Index" role="button" class="btn btn-block btn-default btn-sm">Volver</a>
                </div>
                <div class="col-md-3 my-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" role="button" class="btn btn-block btn-default btn-sm">Editar</a>
                </div>               
                @if (User.IsInRole("Cliente")||User.IsInRole("Coordinador"))
                {
                <div class="col-md-3 my-2">
                    <a asp-area="Tecnica" asp-controller="Solicitudes" asp-action="Create" asp-route-idActivo="@Model.Id" asp-route-idCliente="@Model.PersonaId" type="button" class="btn btn-block btn-default btn-sm">Solicitar</a>
                </div>
                }
                <div class="col-md-3 my-2">
                    <a asp-area="Tecnica" asp-controller="Servicios" asp-action="HistorialPorActivo" asp-route-idActivo="@Model.Id" role="button" class="btn btn-block btn-default btn-sm">Historial</a>
                </div>

            </div>

        </div>


        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Serial)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Serial)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.TipoActivo)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.TipoActivo.Nombre)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Descripcion)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Descripcion)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.MarcaActivo)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.MarcaActivo.Nombre)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.ModeloActivo)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.ModeloActivo.Nombre)
                </dd>
                 <dt class="col-sm-4">
                   @Html.DisplayNameFor(model => model.Ubicacion)
                  </dt>
                 <dd class="col-sm-8">
                   @Html.DisplayFor(model => model.Ubicacion.Municipio) , @Html.DisplayFor(model => model.Ubicacion.Departamento)
                  </dd>
                     <dt class="col-sm-4">
                   @Html.DisplayNameFor(model => model.Direccion)
                  </dt>
                 <dd class="col-sm-8">
                   @Html.DisplayFor(model => model.Direccion)
                  </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.FechaRegistro)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.FechaRegistro)
                </dd>
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Persona)
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.Persona.Nombres) @Html.DisplayFor(model => model.Persona.Apellidos)
                </dd>
            </dl>
        </div>
    </div>
</div>



