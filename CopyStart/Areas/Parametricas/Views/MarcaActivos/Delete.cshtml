@model CopyStart.Entities.MarcaActivo

@{
    ViewData["Title"] = "Borrar";
}


  <div class="row justify-content-center">
  

    <div class="col-md-6">
        <div class="mt-3">
            <div class="ml-3">
                <div class="card card-primary">
                    <div class="card-header bg-red">
                        ¿Quieres borrar esta marca de activo?
                    </div>


                    <div class="card-body">
                        <p>Recuerda: No es posible eliminar una marca de activo si hay modelos referenciados a el</p>
                        <dl class="row">
                            <dt class = "col-sm-4">
                                @Html.DisplayNameFor(model => model.TipoActivo)
                            </dt>
                            <dd class = "col-sm-8">
                                @Html.DisplayFor(model => model.TipoActivo.Codigo)
                            </dd class>
                            <dt class = "col-sm-4">
                                @Html.DisplayNameFor(model => model.Nombre)
                            </dt>
                            <dd class = "col-sm-8">
                                @Html.DisplayFor(model => model.Nombre)
                            </dd>
                            <dt class = "col-sm-4">
                                @Html.DisplayNameFor(model => model.Descripcion)
                            </dt>
                            <dd class = "col-sm-8">
                                @Html.DisplayFor(model => model.Descripcion)
                            </dd>
                            <dt class = "col-sm-4">
                                @Html.DisplayNameFor(model => model.Codigo)
                            </dt>
                            <dd class = "col-sm-8">
                                @Html.DisplayFor(model => model.Codigo)
                            </dd>
                            <dt class = "col-sm-4">
                                @Html.DisplayNameFor(model => model.Estado)
                            </dt>
                            <dd class = "col-sm-8">
                                @Html.DisplayFor(model => model.Estado)
                            </dd>
                     </dl>
                    </div>
                    <div class="card-footer">
                        <form asp-action="Delete">
                            <input type="hidden" asp-for="Id" />
                            <input type="submit" value="Borrar" class="btn btn-danger" />
                            <button type="button" class="btn btn-default"> <a asp-action="Index">Volver</a></button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>