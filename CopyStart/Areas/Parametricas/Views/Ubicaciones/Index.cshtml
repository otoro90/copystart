@model IEnumerable<CopyStart.Entities.Ubicacion>

@{
    ViewData["Title"] = "Index";
}


<div class="row ">
    <div class="col-12">
        <div class="card">


            <div class="card-body table-responsive">

                <table class="table table-bordered table-hover text-center" id="table-ubicaciones">
                    <thead>
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.Municipio)
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Municipio)
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.CodigoMunicipio">Edit</a> |
                                    <a asp-action="Details" asp-route-id="@item.CodigoMunicipio">Details</a> |
                                    <a asp-action="Delete" asp-route-id="@item.CodigoMunicipio">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>