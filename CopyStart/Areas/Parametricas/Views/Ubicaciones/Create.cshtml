@model CopyStart.Entities.Ubicacion

@{
    ViewData["Title"] = "Crear ubicacion";
}

<div class="row justify-content-center">


    <div class="col-md-12">
        <div class="mt-3">

            <div class="card card-primary">
                <div class="card-header"></div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div class="row">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <div class="form-group col-md-4">
                                <label asp-for="CodigoMunicipio" class="control-label">Departamento</label>
                                <input asp-for="CodigoMunicipio" class="form-control" />
                                <span asp-validation-for="CodigoMunicipio" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="Departamento" class="control-label">Departamento</label>
                                <input asp-for="Departamento" class="form-control">

                                <span asp-validation-for="Municipio" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="Municipio" class="control-label">Municipio</label>
                                <input asp-for="Municipio" class="form-control" />
                                <span asp-validation-for="Municipio" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Latitud" class="control-label">Municipio</label>
                                <input asp-for="Latitud" class="form-control" />
                                <span asp-validation-for="Latitud" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Longitud" class="control-label">Municipio</label>
                                <input asp-for="Longitud" class="form-control" />
                                <span asp-validation-for="Longitud" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-12">
                                <input type="submit" value="Crear" class="btn btn-primary float-right" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }
