@model CopyStart.Entities.TipoServicio

@{
    ViewData["Title"] = "Details";
    var urlTipoServicios = "/Administracion/ProcedimientoTipoServicios/?tipoServicioId="+Model.Id;
}


 <div class="row">
    <div class="col-md-3">
    </div>
    <div class="col-md-6 card">
        <div class="card-header">
            <h4 class="col-md-12">Detalles de tipo de servicio</h4>

            <div class="row">
                
                <div class="col-md-3 my-2">
                    <button type="button" class="btn btn-block btn-default btn-sm"><a asp-action="Index">Volver</a> </button>
                </div>
                 <div class="col-md-3 my-2">
                     <button type="button" class="btn btn-block btn-default btn-sm"> <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a></button>
                     
                </div>
                <div class="col-md-3 my-2">
                    <a role="button" class="btn btn-block btn-default btn-sm" href="@urlTipoServicios">Ver Procedimientos</a>                     
                </div>
                <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Descripcion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Descripcion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Codigo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Codigo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Estado)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Estado)
        </dd>
    </dl>

            </div>
        </div>     
    </div>
    <div class="col-md-3"></div>
</div>