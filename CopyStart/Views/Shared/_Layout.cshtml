@using AdminLte.Mvc.Views.Shared.Components.Header
@using AdminLte.Mvc.Views.Shared.Components.Sidebar
@using AdminLte.Mvc.Views.Shared.Components.ControlSidebar
@using AdminLte.Mvc.Views.Shared.Components.Footer

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="x-ua-compatible" content="ie=edge">

    <title>CopyStart | @ViewData["Title"]</title>

    <link rel="icon" type="image/png" href="~/lib/admin-lte/dist/img/AdminLTELogo.png" />

    @await Html.PartialAsync("Layout/_Styles.cshtml")
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="hold-transition login-page">
    <div class="login-box w-50">

        @RenderBody()

    </div>
        @await Html.PartialAsync("Layout/_Scripts.cshtml")
        @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
