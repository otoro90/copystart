@using Microsoft.AspNetCore.Identity
﻿@using CopyStart.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Cuenta</a>
        </li>

       <li class="nav-item dropdown">
        <a class="nav-link text-dark" data-toggle="dropdown" href="#" aria-expanded="false"> 
         <p> Ajustes</p>
        </a>
        <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right" style="left: inherit; right: 0px;">
          <a href="/Identity/Account/Manage/Email" class="dropdown-item">
            Cambiar correo electronico
          </a>
          <div class="dropdown-divider"></div>
          <a href="/Identity/Account/Manage/ChangePassword" class="dropdown-item">
                Cambiar contraseña
          </a>
          <div class="dropdown-divider"></div>
          <a href="/Identity/Account/Manage/TwoFactorAuthentication" class="dropdown-item">
              Autenticacion en dos pasos
          </a>
          <div class="dropdown-divider"></div>
         <a href="/Identity/Account/Manage/DeletePersonalData" class="dropdown-item">
             Suspender o eliminar cuenta
          </a>
        </div>
      </li>

        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    }
</ul>