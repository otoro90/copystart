@using AdminLte.Mvc.Views.Shared.Components.Header
@using AdminLte.Mvc.Views.Shared.Components.Sidebar
@using AdminLte.Mvc.Views.Shared.Components.ControlSidebar
@using AdminLte.Mvc.Views.Shared.Components.Footer
@using CopyStart.Models;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="x-ua-compatible" content="ie=edge">

    <title>CopyStart | @ViewData["Title"]</title>

    <link rel="icon" type="image/png" href="~/images/logo.svg" />

    @await Html.PartialAsync("_Styles.cshtml")
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="hold-transition sidebar-mini">
    <div class="wrapper">
        @(await Component.InvokeAsync<HeaderViewComponent>())
        @(await Component.InvokeAsync<SidebarViewComponent>())


        <div class="content-wrapper" style="background-image:url('../images/Wall.png'); background-repeat:no-repeat; background-position:center; background-size:contain">
            <section class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1>@ViewData["Title"]</h1>
                        </div>
                        <div class="col-sm-6">
                            @if (ViewBag.Breadcrumbs != null)
                            {
                                <ol class="breadcrumb float-sm-right">
                                    @foreach (var breadcrumb in ViewBag.Breadcrumbs as List<Breadcrumb>)
                                    {
                                        if (breadcrumb.Active)
                                        {
                                <li class="breadcrumb-item active">
                                    <a asp-action="@breadcrumb.Action"
                                       asp-controller="@breadcrumb.Controller"
                                       asp-all-route-data="@breadcrumb.Params"
                                       asp-area="@breadcrumb.Area">
                                       @breadcrumb.Text
                                    </a>
                                </li>
                                        }
                                        else
                                        {
                                            <li class="breadcrumb-item active" aria-current="page">@breadcrumb.Text</li>
                                        }
                                    }
                                </ol>
                            }
                        </div>
                    </div>
                </div><!-- /.container-fluid -->
            </section>
            <section class="content">
                <div class="container-fluid">

                    @RenderBody()
                </div>
                <!-- /.container-fluid -->
            </section>
            <!-- /.content -->
        </div>
        @(await Component.InvokeAsync<ControlSidebarViewComponent>())
        @(await Component.InvokeAsync<FooterViewComponent>())
    </div>

    <div id="PlaceHolderHere"></div>

    @await Html.PartialAsync("_Scripts.cshtml")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<script src="~/js/site.js" type="text/javascript"></script>
<script type="text/javascript">
    $(document).ready(function() {
        site.init();
    });
</script>

@if (ViewData["ScriptUrl"] != null)
{
    <script src="@ViewData["ScriptUrl"]" type="text/javascript"></script>
    <script type="text/javascript">
    $(document).ready(function () {
        (@ViewData["Page"]).init();
    });
    </script>
}
